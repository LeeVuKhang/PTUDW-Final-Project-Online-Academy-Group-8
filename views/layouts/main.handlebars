<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CourseCademy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
{{!--   
  <script src="https://cdn.tailwindcss.com"></script> --}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/home.css">
  {{{_sections.stylesheet}}}
  <style>
      {{{_sections.css}}}
  </style>
</head>

<body>
  <nav class="navbar navbar-expand-lg bg-light border-bottom shadow w-100">
    <div class="container-fluid px-3 mb-2 mt-2">
      <a class="navbar-brand fw-bold text-primary" href="/">
        <i class="bi bi-mortarboard"></i> CourseCademy
      </a>

      <div class="collapse navbar-collapse" id="navbarMenu">
        <!--Category Dropdown-->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown"
              aria-expanded="false">
              Explore
            </a>
            <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
              {{#each globalCategories}}
              <li>
                <a class="dropdown-item" href="/products/byCat?id={{catid}}">
                  {{catname}}
                </a>
              </li>
              {{/each}}
            </ul>
          </li>
        </ul>

        <!-- Search -->
        <form class="d-flex me-4 w-50 position-relative" role="search" action="/search" method="get">
          <i class="bi bi-search position-absolute text-secondary"
            style="left: 12px; top: 50%; transform: translateY(-50%);"></i>
          <input class="form-control ps-5 shadow-none" type="search" name="q" placeholder="Search for anything ..."
            aria-label="Search" />
        </form>

        <form id="frmSignout" action="/account/signout" method="post"></form>
        <li class="nav-item d-flex align-items-center">
          <a class="btn btn-outline-primary me-2 px-3 py-1" href="/account/signin">
            Sign In
          </a>
          <a class="btn btn-primary px-3 py-1" href="/account/signup">
            Sign Up
          </a>
        </li>
      </div>
  </nav>


  <div class="container-fluid  mb-4">
    <div class="row">
      {{{body}}}
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
  {{{_sections.js}}}
</body>

</html>