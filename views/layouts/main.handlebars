  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/home.css">
  {{{_sections.stylesheet}}}
  <style>
      {{{_sections.css}}}
  </style>
  <script>
    window.SUPABASE_URL = 'https://ezfycqjmcogueofgdxyc.supabase.co';
    window.SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV6ZnljcWptY29ndWVvZmdkeHljIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjAyNDkzNzAsImV4cCI6MjA3NTgyNTM3MH0.XyO5GRMb8Z3W1w-WzBoJd2A4mALc2CkLIARjxS9cyso';
