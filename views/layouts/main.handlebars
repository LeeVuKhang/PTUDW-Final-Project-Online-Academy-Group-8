<body>
  <nav class="navbar navbar-expand-lg bg-light border-bottom shadow w-100">
    <div class="container-fluid px-3 mb-2 mt-2">
      <a class="navbar-brand fw-bold text-primary" href="/">
        <i class="bi bi-mortarboard"></i> CourseCademy
      </a>

      <div class="collapse navbar-collapse" id="navbarMenu">
        <!--Category Dropdown-->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown"
              aria-expanded="false">
              Explore
            </a>

            <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
              {{#each parents}}
              {{#if children}}
              <!-- Có con -->
              <li class="dropdown-submenu position-relative">
                <a class="dropdown-item dropdown-toggle" href="/products/byCat?id={{cat_id}}">
                  {{cat_name}}
                </a>
                <ul class="dropdown-menu">
                  {{#each children}}
                  <li>
                    <a class="dropdown-item" href="/products/byCat?id={{cat_id}}">
                      {{cat_name}}
                    </a>
                  </li>
                  {{/each}}
                </ul>
              </li>
              {{else}}
              <!-- Không có con -->
              <li>
                <a class="dropdown-item" href="/products/byCat?id={{cat_id}}">
                  {{cat_name}}
                </a>
              </li>
              {{/if}}
              {{/each}}
            </ul>

          </li>
        </ul>

        <!-- Search -->
        <form class="d-flex me-4 w-50 position-relative" role="search" action="/search" method="get">
          <i class="bi bi-search position-absolute text-secondary"
            style="left: 12px; top: 50%; transform: translateY(-50%);"></i>
          <input class="form-control ps-5 shadow-none" type="search" name="q" placeholder="Search for anything ..."
            aria-label="Search" />
        </form>

        <form id="frmSignout" action="/account/signout" method="post"></form>
        <li class="nav-item d-flex align-items-center">
          {{#if authUser}}
          <span class="me-3">Hello, {{authUser.name}}</span>
          <button class="btn btn-outline-danger me-2 px-3 py-1" form="frmSignout">
            Sign Out
          </button>
          {{else}}
          <a class="btn btn-outline-primary me-2 px-3 py-1" href="/account/signin">
            Sign In
          </a>
          <a class="btn btn-primary px-3 py-1" href="/account/signup">
            Sign Up
          </a>
          {{/if}}
        </li>
      </div>
  </nav>


  <div class="container-fluid  mb-4">
    <div class="row">
      {{{body}}}
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
