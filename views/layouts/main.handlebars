</head>

<body>
  <nav class="navbar navbar-expand-lg bg-light border-bottom shadow w-100 ">
    <div class="container-fluid px-3 mb-2 mt-2">
      <a class="navbar-brand fw-bold text-primary" href="/">
        <i class="bi bi-mortarboard"></i> CourseCademy
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMenu">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
             <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown"
              aria-expanded="false">
              Categories
            </a>
            <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
              {{#each parents}}
              {{#if children}}
              <li class="dropdown-submenu position-relative">
                <a class="dropdown-item dropdown-toggle" href="/course/byCat?id={{cat_id}}">
                  {{cat_name}}
                </a>
                <ul class="dropdown-menu">
                  {{#each children}}
                  <li>
                    <a class="dropdown-item" href="/course/byCat?id={{cat_id}}">
                      {{cat_name}}
                    </a>
                  </li>
                  {{/each}}
                </ul>
              </li>
              {{else}}
              <li>
                <a class="dropdown-item" href="/course/byCat?id={{cat_id}}">
                  {{cat_name}}
                </a>
              </li>
              {{/if}}
              {{/each}}
            </ul>
          </li>
        </ul>

        <form class="d-flex me-4 w-50 position-relative" 
              role="search" action="/search" method="get">
          <i class="bi bi-search position-absolute text-secondary"
            style="left: 12px; top: 50%; transform: translateY(-50%);"></i>
          <input class="form-control ps-5 shadow-none" type="search" name="q" placeholder="Search for anything ..."
            aria-label="Search" />
        </form>

        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 d-flex flex-row align-items-center">
          {{#if isAuthenticated}}
          <li class="nav-item me-3">
            <a class="nav-link" href="/course/my-courses" title="My Learning">
              My learning
            </a>
          </li>
          <li class="nav-item me-3">
            <a class="nav-link" href="/account/watchlist" title="My Watchlist">
              <i class="bi bi-heart fs-5"></i>
            </a>
          </li>
          <li class="nav-item me-3">
            <a class="nav-link position-relative" href="/course/cart" title="My Cart">
              <i class="bi bi-cart3 fs-5"></i>
              {{#if cartCount}}
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                {{cartCount}}
                <span class="visually-hidden">items in cart</span>
              </span>
              {{/if}}
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button"
              data-bs-toggle="dropdown" aria-expanded="false">
              <span class="me-2 d-none d-lg-inline">
                {{#if authUser.name}}{{authUser.name}}{{else}}{{authUser.username}}{{/if}}
              </span>
              <i class="bi bi-person-circle fs-5"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
               <li>
                  <a class="dropdown-item" href="/course/my-courses">
                    <i class="bi bi-play-circle-fill me-2 text-info"></i> My Learning
                  </a>
                </li>
               <li>
                  <a class="dropdown-item" href="/course/cart">
                    <i class="bi bi-cart3 me-2 text-success"></i> My Cart
                  </a>
                </li>
                <li>
                  <a class="dropdown-item" href="/account/watchlist">
                   <i class="bi bi-heart me-2 text-danger"></i> Watchlist
                  </a>
                </li>
                <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="/account/profile">
                  <i class="bi bi-person-gear me-2 text-secondary"></i> Account details
                </a>
              </li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li>
                <button class="dropdown-item text-danger" type="button"
                  onclick="document.getElementById('frmSignout').submit()">
                  <i class="bi bi-box-arrow-right me-1"></i> Sign out
                </button>
              </li>
            </ul>
          </li>
          <form id="frmSignout" action="/account/signout" method="post" class="d-none"></form>
          {{else}}
          <li class="nav-item d-flex align-items-center">
            <a class="btn btn-outline-primary me-2 px-3 py-1 text-nowrap" href="/account/signin">Sign In</a>
            <a class="btn btn-primary px-3 py-1 text-nowrap" href="/account/signup">Sign Up</a>
          </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid mb-4">
    <div class="row">
      {{{body}}}
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
  {{{_sections.js}}}
</body>

</html>