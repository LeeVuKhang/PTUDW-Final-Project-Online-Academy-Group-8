</head>

<body>
  <nav class="navbar navbar-expand-lg bg-light border-bottom shadow w-100">
    <div class="container-fluid px-3 mb-2 mt-2">
      <a class="navbar-brand fw-bold text-primary" href="/">
        <i class="bi bi-mortarboard"></i> CourseCademy
      </a>

      <div class="collapse navbar-collapse" id="navbarMenu">
        <!--Category Dropdown-->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown"
              aria-expanded="false">
              Explore
            </a>
            <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
              {{#each globalCategories}}
              <li>
                <a class="dropdown-item" href="/products/byCat?id={{catid}}">
                  {{catname}}
                </a>
              </li>
              {{/each}}
            </ul>
          </li>
        </ul>

        <!-- Search -->
        <form class="d-flex me-4 w-50 position-relative" role="search" action="/search" method="get">
          <i class="bi bi-search position-absolute text-secondary"
            style="left: 12px; top: 50%; transform: translateY(-50%);"></i>
          <input class="form-control ps-5 shadow-none" type="search" name="q" placeholder="Search for anything ..."
            aria-label="Search" />
        </form>

        <form id="frmSignout" action="/account/signout" method="post"></form>
        <li class="nav-item d-flex align-items-center">
         {{#if isAuthenticated}}
  <ul class="navbar-nav ms-auto">
    <li class="nav-item dropdown">
      <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="me-2">
          {{#if authUser.name}}{{authUser.name}}{{else}}{{authUser.username}}{{/if}}
        </span>
        <i class="bi bi-person-circle fs-5"></i>
      </a>
      <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
        <li>
          <a class="dropdown-item" href="/account/profile">Account details</a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <button class="dropdown-item text-danger" type="button" onclick="document.getElementById('frmSignout').submit()">
            <i class="bi bi-box-arrow-right me-1"></i> Sign out
          </button>
        </li>
      </ul>
    </li>
  </ul>
{{else}}
  <li class="nav-item d-flex align-items-center">
    <a class="btn btn-outline-primary me-2 px-3 py-1" href="/account/signin">Sign In</a>
    <a class="btn btn-primary px-3 py-1" href="/account/signup">Sign Up</a>
  </li>
{{/if}}
        </li>
      </div>
  </nav>


  <div class="container-fluid  mb-4">
    <div class="row">
      {{{body}}}
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
  {{{_sections.js}}}
</body>

</html>