<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - CourseCademy Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/main.css">
  {{{_sections.stylesheet}}}
  <style>
    {{{_sections.css}}}
    .admin-sidebar {
      min-height: 100vh;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .admin-sidebar .nav-link {
      color: rgba(255, 255, 255, 0.8);
      padding: 0.75rem 1rem;
      border-radius: 0.375rem;
      margin: 0.25rem 0;
    }
    .admin-sidebar .nav-link:hover,
    .admin-sidebar .nav-link.active {
      color: white;
      background-color: rgba(255, 255, 255, 0.1);
    }
    .admin-content {
      background-color: #f8f9fa;
      min-height: 100vh;
    }
  </style>
</head>

<body>
  <div class="container-fluid">
    <div class="row">
      <!-- Admin Sidebar -->
      <nav class="col-md-3 col-lg-2 admin-sidebar p-3">
        <div class="position-sticky pt-3">
          <!-- Admin Brand -->
          <div class="mb-4">
            <h5 class="text-white">
              <i class="bi bi-shield-check"></i> Admin Panel
            </h5>
            <small class="text-light">Xin chào, {{authUser.name}}</small>
          </div>

          <!-- Navigation Menu -->
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="/admin">
                <i class="bi bi-speedometer2"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/categories">
                <i class="bi bi-tags"></i> Quản lý danh mục
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/courses">
                <i class="bi bi-book"></i> Quản lý khóa học
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/users/students">
                <i class="bi bi-people"></i> Quản lý học viên
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/users/instructors">
                <i class="bi bi-mortarboard"></i> Quản lý giảng viên
              </a>
            </li>
            <hr class="text-white">
            <li class="nav-item">
              <a class="nav-link" href="/">
                <i class="bi bi-house"></i> Về trang chính
              </a>
            </li>
            <li class="nav-item">
              <form id="frmSignout" action="/account/signout" method="post" class="d-inline">
                <button class="nav-link btn btn-link text-start w-100" type="submit">
                  <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
              </form>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Main Content -->
      <main class="col-md-9 ms-sm-auto col-lg-10 admin-content">
        <div class="p-4">
          {{{body}}}
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
  {{{_sections.js}}}
</body>

</html>