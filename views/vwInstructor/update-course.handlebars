<script>
    // ... (Existing Cleave.js and Image Preview JS) ...

    // --- JS FOR DYNAMIC LECTURER INPUTS ---
    const totalLecturesInput = document.getElementById('totalLectures');
    const lecturerInputsContainer = document.getElementById('lecturerInputsContainer');

    if (totalLecturesInput && lecturerInputsContainer) {
        totalLecturesInput.addEventListener('input', generateLecturerInputs);
        
        // Optional: Generate initial fields if editing and course.total_lectures has a value
        // generateLecturerInputs(); 
    }

    function generateLecturerInputs() {
        // Clear previous inputs
        lecturerInputsContainer.innerHTML = '';

        const count = parseInt(totalLecturesInput.value, 10);

        if (isNaN(count) || count <= 0) {
            return; // Do nothing if input is not a positive number
        }

        // Add a label for the section
        const sectionLabel = document.createElement('label');
        sectionLabel.className = 'block text-gray-700 font-semibold mb-2';
        sectionLabel.textContent = 'Enter Lecturer IDs';
        lecturerInputsContainer.appendChild(sectionLabel);

        for (let i = 1; i <= count; i++) {
            // Create elements for each row
            const inputGroup = document.createElement('div');
            inputGroup.className = 'flex items-center gap-1';

            const label = document.createElement('label');
            label.className = 'w-1/2 text-sm font-medium text-gray-600'; // Adjusted width
            label.textContent = `Lecture ${i} - ID:`;
            label.setAttribute('for', `lecturer_id_${i}`); // Link label to input

            const input = document.createElement('input');
            input.type = 'text'; // Use text initially, or number if IDs are numeric only
            input.id = `lecturer_id_${i}`;
            input.name = `lecturer_ids[${i-1}]`; // Send as an array element
            input.className = 'w-1/3 px-3.5 py-2 border border-gray-500 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out'; // Adjusted width
            input.placeholder = `Enter ID`;
            
            const nameDisplay = document.createElement('span');
            nameDisplay.id = `lecturer_name_${i}`;
            nameDisplay.className = 'w-1/3 text-sm text-gray-700 italic'; // Adjusted width
            nameDisplay.textContent = '(Name will appear here)';

            // Add event listener to fetch name when input loses focus (blur)
            input.addEventListener('blur', fetchLecturerName);

            // Append elements
            inputGroup.appendChild(label);
            inputGroup.appendChild(input);
            inputGroup.appendChild(nameDisplay);
            lecturerInputsContainer.appendChild(inputGroup);
        }
    }

    async function fetchLecturerName(event) {
        const inputElement = event.target;
        const lecturerId = inputElement.value.trim();
        const index = inputElement.id.split('_')[2]; // Get the index (1, 2, ...)
        const nameDisplayElement = document.getElementById(`lecturer_name_${index}`);

        if (!lecturerId) {
            nameDisplayElement.textContent = '(Name will appear here)';
            nameDisplayElement.className = 'w-1/2 text-sm text-gray-700 italic'; // Reset style
            return;
        }

        nameDisplayElement.textContent = 'Searching...';
        nameDisplayElement.className = 'w-1/2 text-sm text-gray-500 italic'; // Indicate searching

        try {
            // !!! IMPORTANT: Replace '/api/lecturers/' with your actual API endpoint !!!
            const response = await fetch(`/api/lecturers/${lecturerId}`);

            if (!response.ok) {
                if(response.status === 404) {
                   nameDisplayElement.textContent = 'ID Not Found';
                   nameDisplayElement.className = 'w-1/2 text-sm text-red-600 font-medium'; // Error style
                } else {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
            } else {
                const lecturerData = await response.json();
                if (lecturerData && lecturerData.name) {
                    nameDisplayElement.textContent = lecturerData.name;
                    nameDisplayElement.className = 'w-1/2 text-sm text-green-700 font-semibold'; // Success style
                } else {
                     nameDisplayElement.textContent = 'Name not available';
                     nameDisplayElement.className = 'w-1/2 text-sm text-orange-600 italic'; // Warning style
                }
            }
        } catch (error) {
            console.error('Error fetching lecturer name:', error);
            nameDisplayElement.textContent = 'Error fetching name';
            nameDisplayElement.className = 'w-1/2 text-sm text-red-600 font-medium'; // Error style
        }
    }
    // --- END JS FOR DYNAMIC LECTURER INPUTS ---
</script>
