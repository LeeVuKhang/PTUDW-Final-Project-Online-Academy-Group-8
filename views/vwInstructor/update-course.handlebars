    const cleaveCurrent = new Cleave('#discount_price', {
        numeral: true,
        numeralThousandsGroupStyle: 'thousand'
    });

    const cleaveOriginal = new Cleave('#price', {
        numeral: true,
        numeralThousandsGroupStyle: 'thousand'
    });

    // Xử lý submit để gửi giá trị số thô
    const form = document.getElementById('courseForm');
    form.addEventListener('submit', function (e) {
        document.getElementById('discount_price').value = cleaveCurrent.getRawValue();
        document.getElementById('price').value = cleaveOriginal.getRawValue();
    });

