<div class="container mx-auto px-4 py-12 max-w-4xl">

    <form id="courseForm" class="bg-white rounded-xl shadow-lg p-10" method="post">

        <div class="mb-8 text-center">
            <h1 class="text-4xl font-extrabold text-gray-800 mb-3 flex items-center justify-center">
                <i class="fas fa-edit text-blue-500 mr-3"></i>
                Update Course
            </h1>
            <p class="text-gray-600 text-lg">Update the information below for the course</p>
        </div>

        <hr class="my-8 border-gray-200">

        <div class="space-y-6">

            {{!-- Course Title --}}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">
                    Course Title <span class="text-red-500">*</span>
                </label>
                <input type="text" id="title" name="title" value="{{course.title}}" autofocus
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                    placeholder="e.g. Complete Python Programming Masterclass 2025" required>
            </div>

            {{!-- Short Description --}}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">
                    Short Course Description <span class="text-red-500">*</span>
                </label>
                <textarea id="tinydes" name="tinydes" rows="4"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                    placeholder="Short summary for course listings..." required>{{course.tinydes}}</textarea>
                <p class="text-sm text-gray-500 mt-1">Minimum 50 characters</p>
            </div>

            {{!-- Full Description --}}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">
                    Full Course Description <span class="text-red-500">*</span>
                </label>
                <textarea id="fulldes" name="fulldes" rows="8"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                    placeholder="Detailed description for the course page..." required>{{course.fulldes}}</textarea>
                <p class="text-sm text-gray-500 mt-1">Minimum 200 characters</p>
            </div>

            {{!-- Course Image URL --}}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">
                    Course Image URL <span class="text-red-500">*</span>
                </label>
                {{!-- THAY ĐỔI: Thêm ID mới cho input --}}
                <input type="url" id="imageUrlInput" name="image_url" value="{{course.image_url}}"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                    placeholder="https://example.com/course-image.jpg" required>
                <p class="text-sm text-gray-500 mt-1">Enter a valid image URL. The preview will update below.</p>

                <div class="mt-4">
                    <img id="imagePreview" src="{{course.image_url}}" alt="Course Image Preview"
                        class="rounded-lg shadow-md border w-full h-auto object-cover max-h-80"
                        onerror="handleImageError(this)"> {{!-- Gọi hàm JS khi lỗi --}}

                    <p id="imageError" class="mt-2 text-sm text-red-600 font-medium" style="display: none;">
                        <i class="fas fa-exclamation-triangle mr-1"></i> Cannot load image preview. Please check the
                        URL.
                    </p>
                </div>


            </div>

        </div>
        <hr class="my-8 border-gray-200">

        {{!-- Phần còn lại của form (Total Hours, Lectures, Category, Level, Price...) giữ nguyên --}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
            {{!-- Total Hours --}}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">
                    Total Hours <span class="text-red-500">*</span>
                </label>
                <input type="text" id="total_hours" name="total_hours" value="{{course.total_hours}}"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                    placeholder="10.5" required>
                <p class="text-sm text-gray-500 mt-1">Course duration in hours</p>
            </div>

            {{!-- Total Lectures --}}
            <div>
                <label class="block text-gray-700 font-semibold mb-2">
                    Total Lectures <span class="text-red-500">*</span>
                </label>
                {{!-- Input type should ideally be number, min="0" --}}
                <input type="number" id="totalLectures" name="total_lectures" value="{{course.total_lectures}}" min="0"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                    placeholder="Enter number of lectures" required> {{!-- Changed placeholder --}}
            </div>

            {{!-- THÊM CONTAINER CHO LECTURER INPUTS --}}
            <div id="lecturerInputsContainer" class="space-y-4 mt-4 border-t pt-4">
                {{!-- Dynamic inputs will be added here by JavaScript --}}
            </div>
        </div>

{{!-- Category Select --}}
<div class="mb-6">
    <label class="block text-gray-700 font-semibold mb-2">
        Category <span class="text-red-500">*</span>
    </label>
    <select id="catid" name="catid" required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out">
        <option value="">-- Select Category --</option>
        {{#each categories}}
        <option value="{{this.id}}" {{selectOption ../course.catid this.id}}>{{this.name}}</option>
        {{/each}}
    </select>
</div>

{{!-- Level Select --}}
<div class="mb-6">
    <label class="block text-gray-700 font-semibold mb-2">
        Course Level <span class="text-red-500">*</span>
    </label>
    <select id="level" name="level" required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out">
        <option value="">-- Select Level --</option>
        <option value="Beginner" {{selectOption course.level "Beginner" }}>Beginner</option>
        <option value="Intermediate" {{selectOption course.level "Intermediate" }}>Intermediate</option>
        <option value="Advanced" {{selectOption course.level "Advanced" }}>Advanced</option>
        <option value="All Levels" {{selectOption course.level "All Levels" }}>All Levels</option>
    </select>
</div>
<hr class="my-8 border-gray-200">

{{!-- Price inputs --}}
<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
    {{!-- Current Price (Discount Price) --}}
    <div>
        <label class="block text-gray-700 font-semibold mb-2">
            Current Price (VND) <span class="text-red-500">*</span>
        </label>
        <div class="relative">
            <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">₫</span>
            <input type="text" id="discount_price" name="discount_price" value="{{course.discount_price}}"
                class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                placeholder="279000" required>
        </div>
    </div>

    {{!-- Original Price --}}
    <div>
        <label class="block text-gray-700 font-semibold mb-2">
            Original Price (VND) <span class="text-red-500">*</span>
        </label>
        <div class="relative">
            <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">₫</span>
            <input type="text" id="price" name="price" value="{{course.price}}"
                class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 ease-in-out"
                placeholder="399000" required>
        </div>
    </div>
</div>

<hr class="my-8 border-gray-200">

{{!-- Action Buttons --}}
<div class="flex flex-col sm:flex-row gap-4 justify-end">
    <a href="/instructor/courses"
        class="px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-100 transition-colors duration-200 ease-in-out flex items-center justify-center">
        <i class="fas fa-arrow-left mr-2"></i>
        Cancel
    </a>
    <button type="submit"
        class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors duration-200 ease-in-out shadow-md">
        <i class="fas fa-save mr-2"></i>
        Save Changes
    </button>
</div>
</form>
</div>