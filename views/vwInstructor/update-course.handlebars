{{#fill_section 'stylesheet'}}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
{{/fill_section}}

{{#fill_section 'css'}}
body {
background-color: #f8f9fa;
}

.ql-editor {
font-size: 1.2rem;
}

.ql-editor.ql-blank::before {
font-size: 1.2rem;
}
{{/fill_section}}

<div class="container-lg py-5">
    <form id="courseForm" class="card shadow-lg p-4 p-md-5 rounded-4" method="post"
        action="/instructor/update/{{course.course_id}}">

        {{!-- Header --}}
        <div class="mb-4 text-center">
            <h1 class="display-5 fw-bold text-dark mb-3">
                <i class="fas fa-edit text-primary me-3"></i> Cập nhật khoá học
            </h1>
            <p class="text-muted fs-5">Cập nhật thông tin khoá học bên dưới</p>
        </div>
        <hr class="my-5">

        {{!-- Course Title --}}
        <div class="mb-4">
            <label for="title" class="form-label fs-6 fw-semibold"> Tiêu đề khoá học <span class="text-danger">*</span>
            </label>
            <input type="text" id="title" name="title" value="{{course.title}}" autofocus
                class="form-control form-control-lg" placeholder="e.g. Complete Python Programming Masterclass 2025"
                required>
        </div>

        {{!-- Short Description --}}
        <div class="mb-4">
            <label for="tinydes" class="form-label fs-6 fw-semibold"> Mô tả ngắn <span
                    class="text-danger">*</span> </label>
            <textarea id="tinydes" name="tinydes" rows="4" class="form-control form-control-lg"
                placeholder="Short summary for course listings..." required>{{course.tinydes}}</textarea>
            <div class="form-text">Tối thiểu 50 ký tự</div>
        </div>

        {{!-- Full Description --}}
        <div class="mb-4">
            <label class="form-label fs-6 fw-semibold"> Mô tả chi tiết khoá học <span class="text-danger">*</span>
            </label>
            <div id="editor" style="height: 250px;">
                {{{course.fulldes}}}
            </div>
            <input type="hidden" id="fulldes" name="fulldes">
            <div class="form-text">Tối thiểu 200 ký tự</div>
        </div>

        {{!-- Course Image URL + Preview --}}
        <div class="mb-4 ">
            <label for="imageUrlInput" class="form-label fs-6 fw-semibold"> Ảnh bìa khoá học (URL) <span
                    class="text-danger">*</span> </label>
            <input type="url" id="imageUrlInput" name="image_url" value="{{course.image_url}}"
                class="form-control form-control-lg" placeholder="https://example.com/course-image.jpg" required>
            <div class="form-text">Điền vào đường dẫn ảnh bìa (URL) hợp lệ. Xem trước ở phía dưới.</div>
            <div class="mt-4">
                <img id="imagePreview" src="{{course.image_url}}" alt="Course Image Preview"
                    class="rounded-3 shadow-sm border d-block mx-auto w-100"
                    style="max-width: 600px; height: 337px; object-fit: contain; background-color: #f8f9fa;"
                    onerror="handleImageError(this)">
                <p id="imageError" class="mt-2 small text-danger fw-medium" style="display: none;"> <i
                        class="fas fa-exclamation-triangle me-1"></i> Không thể tải hình ảnh. Vui lòng kiểm tra lại URL. </p>
            </div>
        </div>

        <hr class="my-5">

        {{!--  Total Hours --}}
        <div class="row g-4 mb-4">
            {{!-- Total Hours --}}
            <div class="col-md-6">
                <label for="total_hours" class="form-label fs-6 fw-semibold"> Thời lượng khoá học <span
                        class="text-danger">*</span> </label>
                <input type="text" id="total_hours" name="total_hours" value="{{course.total_hours}}"
                    class="form-control form-control-lg" placeholder="10.5" required>
                <div class="form-text">Thời lượng tính bằng giờ</div>
            </div>
            {{!-- Total Lectures
            <div class="col-md-6">
                <label for="totalLectures" class="form-label fs-6 fw-semibold"> Total Lectures <span
                        class="text-danger">*</span> </label>
                <input type="number" id="totalLectures" name="total_lectures" value="{{course.total_lectures}}" min="0"
                    class="form-control form-control-lg" placeholder="Enter number of lectures" required>
            </div>
        </div> --}}

        <div id="lecturerInputsContainer" class="mb-4">
        </div>

        {{!-- Category và Level --}}
        <div class="mb-4">
            <label for="catid" class="form-label fs-6 fw-semibold"> Danh mục khoá học <span class="text-danger">*</span>
            </label>
            <select id="catid" name="catid" required class="form-select form-select-lg">
                <option value="">-- Lựa chọn danh mục --</option>
                {{#each categories}}
                <option value="{{this.cat_id}}" {{selectOption ../course.catid this.cat_id}}>{{this.cat_name}}
                </option>
                {{/each}}
            </select>
        </div>
        <div class="mb-4">
            <label for="level" class="form-label fs-6 fw-semibold"> Trình độ <span class="text-danger">*</span>
            </label>
            <select id="level" name="level" required class="form-select form-select-lg">
                <option value="">-- Lựa chọn trình độ --</option>
                <option value="Beginner" {{selectOption course.level "Beginner" }}>Cơ bản</option>
                <option value="Intermediate" {{selectOption course.level "Intermediate" }}>Trung cấp</option>
                <option value="Advanced" {{selectOption course.level "Advanced" }}>Nâng cao</option>
                <option value="All Levels" {{selectOption course.level "All Levels" }}>Mọi trình độ</option>
            </select>
        </div>

        <hr class="my-5">

        {{!-- Price Inputs --}}
        <div class="row g-4 mb-4">
            {{!-- Current Price --}}
            <div class="col-md-6">
                <label for="discount_price" class="form-label fs-6 fw-semibold"> Giá hiện tại (VND) <span
                        class="text-danger">*</span> </L>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">₫</span>
                        <input type="text" id="discount_price" name="discount_price"
                            data-initial-value="{{course.discount_price}}" class="form-control" placeholder="279000"
                            required>
                    </div>
            </div>
            {{!-- Original Price --}}
            <div class="col-md-6">
                <label for="price" class="form-label fs-6 fw-semibold"> Giá gốc (VND) <span
                        class="text-danger">*</span> </label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">₫</span>
                    <input type="text" id="price" name="price" data-initial-value="{{course.price}}"
                        class="form-control" placeholder="399000" required>
                </div>
            </div>
        </div>

        <hr class="my-5">

        {{!-- Action Buttons --}}
        <div class="d-flex flex-column flex-sm-row justify-content-end gap-3">
            <a href="/instructor/courses" class="btn btn-outline-secondary btn-lg"> <i
                    class="fas fa-arrow-left me-2"></i> Trở về </a>
            <button type="button" class="btn btn-outline-danger btn-lg me-auto" id="deleteButton">
                <i class="fas fa-trash-alt me-2"></i> Xoá
            </button>
            <button type="reset" class="btn btn-outline-secondary btn-lg"> <i class="fas fa-redo me-2"></i> Reset </button>
            <button type="submit" class="btn btn-primary btn-lg shadow-sm" id="submitButton">
                <i class="fas fa-save me-2"></i> Lưu và tiếp tục
            </button>
        </div>
    </form>
</div>


{{#fill_section 'js'}}
<script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/cleave.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
    window.handleImageError = function (imgElement) {
        const imageError = document.getElementById('imageError');
        imgElement.style.display = 'none';
        if (imageError) imageError.style.display = 'block';
    }

    document.addEventListener('DOMContentLoaded', function () {

        const quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Detailed description for the course page...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image']
                ]
            }
        });
        const fulldesInput = document.getElementById('fulldes');
        const discountPriceInput = document.getElementById('discount_price');
        const priceInput = document.getElementById('price');
        let cleaveCurrent = null;
        let cleaveOriginal = null;

        if (discountPriceInput) {
            cleaveCurrent = new Cleave(discountPriceInput, {
                numeral: true,
                numeralThousandsGroupStyle: 'thousand'
            });
            const initialDiscountValue = discountPriceInput.getAttribute('data-initial-value');
            if (initialDiscountValue && cleaveCurrent) {
                cleaveCurrent.setRawValue(initialDiscountValue);
            }
        }

        if (priceInput) {
            cleaveOriginal = new Cleave(priceInput, {
                numeral: true,
                numeralThousandsGroupStyle: 'thousand'
            });
            const initialPriceValue = priceInput.getAttribute('data-initial-value');
            if (initialPriceValue && cleaveOriginal) {
                cleaveOriginal.setRawValue(initialPriceValue);
            }
        }

        const form = document.getElementById('courseForm');
        const submitButton = document.getElementById('submitButton');

        if (form) {
            form.addEventListener('submit', function (e) {
                if (quill && fulldesInput) {
                    fulldesInput.value = quill.root.innerHTML;
                    if (quill.getText().trim().length === 0) {
                        fulldesInput.value = "";
                    }
                }
                if (cleaveCurrent && discountPriceInput) {
                    discountPriceInput.value = cleaveCurrent.getRawValue();
                }
                if (cleaveOriginal && priceInput) {
                    priceInput.value = cleaveOriginal.getRawValue();
                }
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Đang xử lý...
                    `;
                }
            });
        }

        const imageUrlInput = document.getElementById('imageUrlInput');
        const imagePreview = document.getElementById('imagePreview');
        const imageError = document.getElementById('imageError');

        if (imageUrlInput && imagePreview && imageError) {
            imageUrlInput.addEventListener('input', function () {
                const url = this.value;
                imageError.style.display = 'none';
                if (url) {
                    imagePreview.src = url;
                } else {
                    imagePreview.src = '';
                    imagePreview.style.display = 'none';
                }
            });

            imagePreview.addEventListener('load', function () {
                imagePreview.style.display = 'block';
                imageError.style.display = 'none';
            });

            if (imageUrlInput.value) {
                if (imagePreview.complete && imagePreview.naturalHeight > 0) {
                    imagePreview.style.display = 'block';
                    imageError.style.display = 'none';
                } else if (imagePreview.complete && imagePreview.naturalHeight === 0) {
                    handleImageError(imagePreview);
                }
            } else {
                imagePreview.style.display = 'none';
                imageError.style.display = 'none';
            }
        }

        const totalLecturesInput = document.getElementById('totalLectures');
        const lecturerInputsContainer = document.getElementById('lecturerInputsContainer');

        function generateLecturerInputs() {
            lecturerInputsContainer.innerHTML = '';
            const count = parseInt(totalLecturesInput.value, 10);
            if (isNaN(count) || count <= 0) return;

            const sectionLabel = document.createElement('label');
            sectionLabel.className = 'h5 fw-semibold mb-3';
            sectionLabel.textContent = 'Lecturer Assignments';
            lecturerInputsContainer.appendChild(sectionLabel);

            for (let i = 1; i <= count; i++) {
                const inputGroup = document.createElement('div');
                inputGroup.className = 'row g-3 align-items-center mb-3';
                const labelDiv = document.createElement('div');
                labelDiv.className = 'col-md-3';
                const label = document.createElement('label');
                label.className = 'form-label col-form-label text-md-end mb-0';
                label.textContent = `Lecture ${i} - ID:`;
                label.setAttribute('for', `lecturer_id_${i}`);
                labelDiv.appendChild(label);
                const inputDiv = document.createElement('div');
                inputDiv.className = 'col-md-3';
                const input = document.createElement('input');
                input.type = 'text';
                input.id = `lecturer_id_${i}`;
                input.name = `lecturer_ids[${i - 1}]`;
                input.className = 'form-control';
                input.placeholder = `Enter ID`;
                input.addEventListener('blur', fetchLecturerName);
                inputDiv.appendChild(input);
                const nameDisplayDiv = document.createElement('div');
                nameDisplayDiv.className = 'col-md-6';
                const nameDisplay = document.createElement('span');
                nameDisplay.id = `lecturer_name_${i}`;
                nameDisplay.className = 'form-text text-muted italic';
                nameDisplay.textContent = '(Name will appear here)';
                nameDisplayDiv.appendChild(nameDisplay);
                inputGroup.appendChild(labelDiv);
                inputGroup.appendChild(inputDiv);
                inputGroup.appendChild(nameDisplayDiv);
                lecturerInputsContainer.appendChild(inputGroup);
            }
        }

        async function fetchLecturerName(event) {
            const inputElement = event.target;
            const lecturerId = inputElement.value.trim();
            const index = inputElement.id.split('_')[2];
            const nameDisplayElement = document.getElementById(`lecturer_name_${index}`);
            if (!lecturerId) {
                nameDisplayElement.textContent = '(Name will appear here)';
                nameDisplayElement.className = 'form-text text-muted italic';
                return;
            }
            nameDisplayElement.textContent = 'Searching...';
            nameDisplayElement.className = 'form-text text-muted italic';
            try {
                const response = await fetch(`/api/lecturers/${lecturerId}`);
                if (!response.ok) {
                    if (response.status === 404) {
                        nameDisplayElement.textContent = 'ID Not Found';
                        nameDisplayElement.className = 'form-text text-danger fw-medium';
                    } else { throw new Error(`HTTP ${response.status}`); }
                } else {
                    const lecturerData = await response.json();
                    if (lecturerData && lecturerData.name) {
                        nameDisplayElement.textContent = lecturerData.name;
                        nameDisplayElement.className = 'form-text text-success fw-semibold';
                    } else {
                        nameDisplayElement.textContent = 'Name N/A';
                        nameDisplayElement.className = 'form-text text-warning italic';
                    }
                }
            } catch (error) {
                console.error('Error fetching lecturer name:', error);
                nameDisplayElement.textContent = 'Fetch Error';
                nameDisplayElement.className = 'form-text text-danger fw-medium';
            }
        }

        if (totalLecturesInput && lecturerInputsContainer) {
            totalLecturesInput.addEventListener('input', generateLecturerInputs);
            generateLecturerInputs(); // Gọi 1 lần khi tải trang để hiển thị
        }

        const deleteButton = document.getElementById('deleteButton');
        const courseId = {{ course.course_id }};

    if (deleteButton && courseId) {
        deleteButton.addEventListener('click', async function (e) {
            e.preventDefault();

            const isConfirmed = confirm(
                "BẠN CÓ CHẮC CHẮN MUỐN XÓA KHÓA HỌC NÀY KHÔNG?"
            );

            if (isConfirmed) {
                try {
                    deleteButton.disabled = true;
                    deleteButton.innerHTML = `<span class="spinner-border spinner-border-sm"></span> Đang xóa...`;
                    const response = await fetch(`/instructor/delete-course`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ course_id: courseId })
                    });

                    if (response.ok) {
                        alert('Complete Delete course!');
                        window.location.href = '/instructor/courses';
                    } else {
                        const errorData = await response.json();
                        alert(`Lỗi khi xóa khóa học: ${errorData.message || 'Error'}`);
                        deleteButton.disabled = false;
                        deleteButton.innerHTML = '<i class="fas fa-trash-alt me-2"></i> Xóa khóa học';
                    }
                } catch (error) {
                    console.error('Fetch error:', error);
                    alert('Lỗi kết nối. Không thể xóa khóa học.');
                    deleteButton.disabled = false;
                    deleteButton.innerHTML = '<i class="fas fa-trash-alt me-2"></i> Xóa khóa học';
                }
            }
        });
    }
    }); 
</script>
{{/fill_section}}