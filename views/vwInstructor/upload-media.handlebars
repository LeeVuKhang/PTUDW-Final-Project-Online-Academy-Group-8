{{#fill_section 'css'}}
body { background-color: #f8f9fa; }

/* CSS cho vùng kéo thả (Copy từ update-course) */
.drop-zone {
    border: 2px dashed #adb5bd;
    border-radius: .5rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
    position: relative;
    background-color: #f8f9fa;
}
.drop-zone:hover, .drop-zone.drop-zone--over {
    background-color: #e9ecef;
    border-color: #0d6efd;
}
.drop-zone .drop-zone-overlay {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #495057;
    font-weight: 500;
}
.drop-zone.is-uploading .drop-zone-overlay,
.drop-zone.is-uploading .preview-content {
    opacity: 0.3;
}
.drop-zone .upload-spinner {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}
.drop-zone.is-uploading .upload-spinner {
    display: block;
}
#imageDropZone {
    min-height: 337px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column; 
    align-items: center;
    justify-content: center;
}
#imagePreview {
    max-width: 100%;
    max-height: 320px;
    object-fit: contain;
    border-radius: .375rem;
}
#videoPreviewContainer {
    display: {{#if course.intro_url}}'block'{{else}}'none'{{/if}};
    width: 100%;
    margin-top: 1rem;
    border-radius: .375rem;
    overflow: hidden;
    background-color: #000;
    max-height: 400px;
}
#videoPreviewContainer video {
    width: 100%;
    height: 100%;
    max-height: 400px;
    object-fit: contain;
}
{{/fill_section}}

<div class="container-lg py-5">
    <div class="card shadow-lg p-4 p-md-5 rounded-4">

        <div class="mb-4 text-center">
            <h1 class="display-5 fw-bold text-dark mb-3">
                <i class="fas fa-photo-video text-primary me-3"></i> Upload Media
            </h1>
            <p class="text-muted fs-5">Tải lên ảnh bìa và video giới thiệu cho khóa học: <strong>{{course.title}}</strong></p>
            <p class="text-muted"> (Bước 2/3)</p>
        </div>
        <hr class="my-5">

        <div class="mb-4 ">
            <label for="imageUrlInput" class="form-label fs-6 fw-semibold"> Ảnh bìa khoá học <span class="text-danger">*</span> </label>
            <input type="text" id="imageUrlInput" name="image_url" value="{{course.image_url}}"
                   class="form-control form-control-lg" placeholder="Kéo thả ảnh vào khung bên dưới, hoặc dán URL" required>
            <div class="form-text">Điền URL, hoặc kéo thả file ảnh vào khung bên dưới.</div>
            
            <div id="imageDropZone" class="mt-4 drop-zone">
                <img id="imagePreview" src="{{#if course.image_url}}{{course.image_url}}{{else}}https://via.placeholder.com/600x337?text=Image+Preview{{/if}}" alt="Course Image Preview"
                     class="preview-content"
                     onerror="handleImageError(this, 'imagePreview', 'imageError')">
                <div class="drop-zone-overlay">
                    <i class="fas fa-upload fs-1"></i>
                    <span>Kéo thả ảnh bìa</span>
                    <small>(hoặc click để chọn file)</small>
                </div>
                <div class="spinner-border text-primary upload-spinner" role="status"></div>
                <input type="file" id="imageFileInput" accept="image/*" class="d-none">
            </div>
            <p id="imageError" class="mt-2 small text-danger fw-medium" style="display: none;"></p>
        </div>

        <hr class="my-5">
        <div class="mb-4">
            <label for="introUrlInput" class="form-label fs-6 fw-semibold"> Video giới thiệu (Tùy chọn) </label>
            <input type="text" id="introUrlInput" name="intro_url" value="{{course.intro_url}}"
                   class="form-control form-control-lg" placeholder="Kéo thả video vào khung bên dưới, hoặc dán URL">
            <div class="form-text">Điền URL (YouTube, Vimeo...) hoặc kéo thả file video (mp4, webm...).</div>
            
            <div id="videoDropZone" class="mt-4 drop-zone p-4">
                <div class="drop-zone-overlay">
                    <i class="fas fa-camera-video fs-1"></i>
                    <span>Kéo thả video giới thiệu</span>
                    <small>(hoặc click để chọn file)</small>
                </div>
                <div class="spinner-border text-primary upload-spinner" role="status"></div>
                <input type="file" id="videoFileInput" accept="video/*" class="d-none">
            </div>
            <div id="videoPreviewContainer">
                <video id="videoPreview" controls src="{{course.intro_url}}"></video>
            </div>
            <p id="videoError" class="mt-2 small text-danger fw-medium" style="display: none;"></p>
        </div>

        <hr class="my-5">

        <div class="d-flex flex-column flex-sm-row justify-content-between gap-3">
            <a href="/instructor/update/{{course.course_id}}" class="btn btn-outline-secondary btn-lg"> 
                <i class="fas fa-arrow-left me-2"></i> Back (Edit Info) 
            </a>

            <a href="/instructor/courses/edit-syllabus/{{course.course_id}}" class="btn btn-primary btn-lg shadow-sm">
                Save and Continue <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>


{{#fill_section 'js'}}
<script>
    window.handleImageError = function (imgElement, previewId, errorId) {
        const defaultSrc = 'https://via.placeholder.com/600x337?text=Invalid+Image';
        if (imgElement.src !== defaultSrc) {
            imgElement.src = defaultSrc;
        }
        const imageError = document.getElementById(errorId);
        if (imageError) {
            imageError.textContent = "Không thể tải ảnh. Vui lòng kiểm tra lại URL.";
            imageError.style.display = 'block';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const courseId = {{ course.course_id }};

        async function uploadFile(file, uploadUrl, inputField, previewElement, errorElement, oldUrl) {
            const dropZone = inputField.closest('.mb-4').querySelector('.drop-zone');
            dropZone.classList.add('is-uploading');
            errorElement.style.display = 'none';

            const formData = new FormData();
            const fieldName = (inputField.id === 'imageUrlInput') ? 'courseImage' : 'introVideo';
            formData.append(fieldName, file);

            if (fieldName === 'introVideo' && oldUrl) {
                 formData.append('oldIntroUrl', oldUrl);
            }

            try {
                const response = await fetch(uploadUrl, {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();

                if (response.ok && data.success) {
                    const newUrl = data.imageUrl || data.videoUrl;
                    inputField.value = newUrl; 
                    
                    if (previewElement.tagName === 'IMG') {
                        previewElement.src = newUrl + '?t=' + new Date().getTime(); 
                    } else if (previewElement.tagName === 'VIDEO') {
                        previewElement.src = newUrl;
                        previewElement.load();
                        previewElement.parentElement.style.display = 'block';
                    }
                    
                    if (fieldName === 'courseImage') {
                        await updateCourseField('image_url', newUrl);
                    } else if (fieldName === 'introVideo') {
                        await updateCourseField('intro_url', newUrl);
                    }

                } else {
                    throw new Error(data.message || 'Upload failed');
                }
            } catch (error) {
                console.error('Upload error:', error);
                errorElement.textContent = `Lỗi: ${error.message}`;
                errorElement.style.display = 'block';
            } finally {
                dropZone.classList.remove('is-uploading');
            }
        }

        async function updateCourseField(fieldName, value) {
            try {
                const response = await fetch(`/instructor/update-field/${courseId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ [fieldName]: value })
                });
                if (!response.ok) {
                    throw new Error('Failed to save URL to database');
                }
                console.log(`${fieldName} updated successfully`);
            } catch (error) {
                console.error(`Error updating ${fieldName}:`, error);
            }
        }

        const imageDropZone = document.getElementById('imageDropZone');
        const imageFileInput = document.getElementById('imageFileInput');
        const imageUrlInput = document.getElementById('imageUrlInput');
        const imagePreview = document.getElementById('imagePreview');
        const imageError = document.getElementById('imageError');
        
        if (imageDropZone && imageFileInput && imageUrlInput && imagePreview) {
            imageDropZone.addEventListener('click', () => imageFileInput.click());
            imageFileInput.addEventListener('change', () => {
                if (imageFileInput.files.length > 0) {
                    uploadFile(imageFileInput.files[0], `/instructor/upload-course-image/${courseId}`, imageUrlInput, imagePreview, imageError);
                }
            });
            imageDropZone.addEventListener('dragover', (e) => { e.preventDefault(); imageDropZone.classList.add('drop-zone--over'); });
            ['dragleave', 'dragend'].forEach(type => imageDropZone.addEventListener(type, () => imageDropZone.classList.remove('drop-zone--over')));
            imageDropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                imageDropZone.classList.remove('drop-zone--over');
                if (e.dataTransfer.files.length > 0) {
                    uploadFile(e.dataTransfer.files[0], `/instructor/upload-course-image/${courseId}`, imageUrlInput, imagePreview, imageError);
                }
            });
            imageUrlInput.addEventListener('input', () => {
                imageError.style.display = 'none';
                if (imageUrlInput.value) {
                    imagePreview.src = imageUrlInput.value;
                    // Tự động lưu khi dán URL và blur
                    imageUrlInput.onblur = () => updateCourseField('image_url', imageUrlInput.value);
                }
                else imagePreview.src = 'https://via.placeholder.com/600x337?text=Image+Preview';
            });
        }
        
        const videoDropZone = document.getElementById('videoDropZone');
        const videoFileInput = document.getElementById('videoFileInput');
        const introUrlInput = document.getElementById('introUrlInput');
        const videoPreview = document.getElementById('videoPreview');
        const videoError = document.getElementById('videoError');
        const videoPreviewContainer = document.getElementById('videoPreviewContainer');
        
        if (videoDropZone && videoFileInput && introUrlInput && videoPreview) {
            videoDropZone.addEventListener('click', () => videoFileInput.click());
            videoFileInput.addEventListener('change', () => {
                if (videoFileInput.files.length > 0) {
                    const oldUrl = introUrlInput.value; 
                    uploadFile(videoFileInput.files[0], `/instructor/upload-intro-video/${courseId}`, introUrlInput, videoPreview, videoError, oldUrl);
                }
            });
            videoDropZone.addEventListener('dragover', (e) => { e.preventDefault(); videoDropZone.classList.add('drop-zone--over'); });
            ['dragleave', 'dragend'].forEach(type => videoDropZone.addEventListener(type, () => videoDropZone.classList.remove('drop-zone--over')));
            videoDropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                videoDropZone.classList.remove('drop-zone--over');
                if (e.dataTransfer.files.length > 0) {
                    const oldUrl = introUrlInput.value;
                    uploadFile(e.dataTransfer.files[0], `/instructor/upload-intro-video/${courseId}`, introUrlInput, videoPreview, videoError, oldUrl);
                }
            });
            introUrlInput.addEventListener('input', () => {
                videoError.style.display = 'none';
                if (introUrlInput.value) {
                    videoPreview.src = introUrlInput.value;
                    videoPreviewContainer.style.display = 'block';
                    videoPreview.load();
                    introUrlInput.onblur = () => updateCourseField('intro_url', introUrlInput.value);
                } else {
                    videoPreview.src = '';
                    videoPreviewContainer.style.display = 'none';
                }
            });
        }
    }); 
</script>
{{/fill_section}}