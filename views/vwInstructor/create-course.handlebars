<div class="container-lg py-5">
    <form id="courseForm" class="card shadow-lg p-4 p-md-5 rounded-4" method="post" action="/instructor/create-course">

        {{!-- Header --}}
        <div class="mb-4 text-center">
            <h1 class="display-5 fw-bold text-dark mb-3">
                <i class="fas fa-plus-circle text-primary me-3"></i> Create New Course
            </h1>
            <p class="text-muted fs-5">Fill in the information below to create a new course</p>
        </div>
        <hr class="my-5">

        {{!-- Course Title --}}
        <div class="mb-4">
            <label for="title" class="form-label fs-6 fw-semibold"> Course Title <span class="text-danger">*</span>
            </label>
            <input type="text" id="title" name="title" autofocus class="form-control form-control-lg"
                placeholder="e.g. Complete Python Programming Masterclass 2025" required>
        </div>

        {{!-- Short Description --}}
        <div class="mb-4">
            <label for="tinydes" class="form-label fs-6 fw-semibold"> Short Course Description <span
                    class="text-danger">*</span> </label>
            <textarea id="tinydes" name="tinydes" rows="4" class="form-control form-control-lg"
                placeholder="Describe what students will learn in this course..." required></textarea>
            <div class="form-text">Minimum 50 characters</div>
        </div>

        <div class="mb-4">
            <label class="form-label fs-6 fw-semibold"> Full Course Description <span class="text-danger">*</span>
            </label>
            <div id="editor" style="height: 250px;">
            </div>
            <input type="hidden" id="fulldes" name="fulldes" required>
            <div class="form-text">Minimum 200 characters</div>
        </div>

        {{!-- Course Image URL + Preview --}}
        <div class="mb-4">
            <label for="imageUrlInput" class="form-label fs-6 fw-semibold"> Course Image URL <span
                    class="text-danger">*</span> </label>
            <input type="url" id="imageUrlInput" name="image_url" class="form-control form-control-lg"
                placeholder="https://example.com/course-image.jpg" required>
            <div class="form-text">Enter a valid image URL. The preview will update below.</div>
            <div class="mt-4">
                <img id="imagePreview" src="{{course.image_url}}" alt="Course Image Preview"
                    class="rounded-3 shadow-sm border d-block mx-auto w-100"
                    style="max-width: 600px; height: 337px; object-fit: contain; background-color: #f8f9fa;"
                    onerror="handleImageError(this)">
                <p id="imageError" class="mt-2 small text-danger fw-medium" style="display: none;"> <i
                        class="fas fa-exclamation-triangle me-1"></i> Cannot load image preview. Please check the URL.
                </p>
            </div>
        </div>

        <hr class="my-5">

        <div class="row g-4 mb-4">
            {{!-- Total Hours --}}
            <div class="col-md-6">
                <label for="total_hours" class="form-label fs-6 fw-semibold"> Total Hours <span
                        class="text-danger">*</span> </label>
                <input type="text" id="total_hours" name="total_hours" class="form-control form-control-lg"
                    placeholder="10.5" required>
                <div class="form-text">Course duration in hours</div>
            </div>
            {{!-- Total Lectures --}}
            <div class="col-md-6">
                <label for="totalLectures" class="form-label fs-6 fw-semibold"> Total Lectures <span
                        class="text-danger">*</span> </label>
                <input type="number" id="totalLectures" name="total_lectures" min="0"
                    class="form-control form-control-lg" placeholder="Enter number of lectures" required>
            </div>
        </div>

        <div id="lecturerInputsContainer" class="mb-4">
        </div>

        {{!-- Nhóm Category và Level --}}
        <div class="mb-4">
            <label for="catid" class="form-label fs-6 fw-semibold"> Category <span class="text-danger">*</span> </label>
            <select id="catid" name="catid" required class="form-select form-select-lg">
                <option value="">-- Select Category --</option>
                {{#each categories}} <option value="{{this.cat_id}}">{{this.cat_name}}</option> {{/each}}
            </select>
        </div>
        <div class="mb-4">
            <label for="level" class="form-label fs-6 fw-semibold"> Course Level <span class="text-danger">*</span>
            </label>
            <select id="level" name="level" required class="form-select form-select-lg">
                <option value="">-- Select Level --</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
                <option value="All Levels">All Levels</option>
            </select>
        </div>

        <hr class="my-5">

        {{!-- Nhóm Price Inputs --}}
        <div class="row g-4 mb-4">
            {{!-- Current Price --}}
            <div class="col-md-6">
                <label for="discount_price" class="form-label fs-6 fw-semibold"> Current Price (VND) <span
                        class="text-danger">*</span> </label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">₫</span>
                    <input type="text" id="discount_price" name="discount_price" class="form-control"
                        placeholder="279000" required>
                </div>
            </div>
            {{!-- Original Price --}}
            <div class="col-md-6">
                <label for="price" class="form-label fs-6 fw-semibold"> Original Price (VND) <span
                        class="text-danger">*</span> </label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">₫</span>
                    <input type="text" id="price" name="price" class="form-control" placeholder="399000" required>
                </div>
            </div>
        </div>

        <hr class="my-5">

        {{!-- Action Buttons --}}
        <div class="d-flex flex-column flex-sm-row justify-content-end gap-3">
            <a href="/instructor/courses" class="btn btn-outline-secondary btn-lg"> <i
                    class="fas fa-arrow-left me-2"></i> Back </a>
            <button type="reset" class="btn btn-outline-secondary btn-lg"> <i class="fas fa-redo me-2"></i> Reset Form
            </button>
            <button type="submit" class="btn btn-primary btn-lg shadow-sm"> <i class="fas fa-save me-2"></i> Create
                Course </button>
        </div>
    </form>
</div>