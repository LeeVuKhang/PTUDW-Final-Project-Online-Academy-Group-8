{{#fill_section 'css'}}
.text-pre-wrap {
white-space: pre-wrap;
}

.card-img-top-custom {
height: 224px;
object-fit: cover;
background-color: #f8f9fa;

}
.avatar-circle {
width: 40px;
height: 40px;
display: flex;
align-items: center;
justify-content: center;
font-weight: bold;
}
{{/fill_section}}

{{#fill_section 'js'}}

{{/fill_section}}

<div class="bg-dark text-white py-5 shadow-inner">
  <div class="container">
    <div class="text-sm fw-semibold mb-2">
      <a href="/categories/{{course.catid}}" class="text-info text-decoration-none">{{course.category_name}}</a>
    </div>
    <h1 class="display-4 fw-bold mb-3">{{course.title}}</h1>
    <p class="fs-5 text-white-50 mb-4">{{course.tinydes}}</p>

    <div class="d-flex flex-wrap align-items-center small gap-3 text-white-50">
      <div class="d-flex align-items-center gap-1">
        <span class="fw-bold text-warning">{{course.rating}}</span>
        <span class="text-warning">{{{renderStars course.rating}}}</span>
        <span>({{formatNumber course.total_reviews}} đánh giá)</span>
      </div>
      <span>{{formatNumber course.student_count}} học viên</span>
    </div>

    <div class="d-flex flex-wrap align-items-center small gap-3 text-white-50 mt-2">
      <span class="badge rounded-pill bg-secondary">{{course.level}}</span>
      <span>Tổng cộng {{course.total_hours}} giờ</span>
      <span>{{course.total_lectures}} bài giảng</span>
    </div>
  </div>
</div>
</div>


<div class="container mt-5">
  <div class="row">

    {{!-- CỘT BÊN TRÁI (NỘI DUNG CHÍNH) --}}
    <div class="col-lg-8">

      {{!-- Video Player --}}
      <div class="shadow rounded-3 mb-4 ratio ratio-16x9 bg-dark">
        <iframe src="https://www.youtube.com/embed/GxmfcnU3feo" title="YouTube video player" frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>

      {{!-- Mô tả khóa học --}}
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Mô tả khóa học</h2>
        <p class="text-secondary leading-relaxed text-pre-wrap">{{course.fulldes}}</p>
      </div>

      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Nội dung khóa học</h2>
        <div class="accordion" id="courseAccordion">

          {{!-- Chương 1 --}}
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
              <button class="accordion-button fs-5 fw-semibold" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                Chương 1: Giới thiệu
              </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne"
              data-bs-parent="#courseAccordion">
              <div class="accordion-body">
                <ul class="list-group list-group-flush">
                  <li class="list-group-item">Bài 1: Tổng quan về Python</li>
                  <li class="list-group-item">Bài 2: Cài đặt môi trường</li>
                </ul>
              </div>
            </div>
          </div>

          {{!-- Chương 2 --}}
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingTwo">
              <button class="accordion-button fs-5 fw-semibold collapsed" type="button" data-bs-toggle="collapse"
                data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                Chương 2: Cú pháp cơ bản
              </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo"
              data-bs-parent="#courseAccordion">
              <div class="accordion-body">
                <ul class="list-group list-group-flush">
                  <li class="list-group-item">Bài 3: Biến và kiểu dữ liệu</li>
                  <li class="list-group-item">Bài 4: Toán tử</li>
                  <li class="list-group-item">Bài 5: Cấu trúc điều khiển</li>
                </ul>
              </div>
            </div>
          </div>


        </div>
      </div>

      {{!-- Đánh giá của học viên --}}
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Đánh giá của học viên</h2>
        <div class="vstack gap-4">

          {{!-- Đánh giá 1 --}}
          <div class="border-bottom pb-3">
            <div class="d-flex align-items-center mb-2">
              <div class="avatar-circle rounded-circle bg-primary bg-opacity-25 text-primary me-3">
                JD
              </div>
              <div>
                <p class="fw-semibold mb-0">John Doe</p>
                <div class="small text-muted">
                  <span class="text-warning">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                      class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                  </span>
                  <span class="ms-1">a week ago</span>
                </div>
              </div>
            </div>
            <p class="text-secondary">"Excellent course! The explanations were clear and concise. Highly recommended
              for
              beginners."</p>
          </div>

          {{!-- Đánh giá 2 --}}
          <div class="border-bottom pb-3">
            <div class="d-flex align-items-center mb-2">
              <div class="avatar-circle rounded-circle bg-danger bg-opacity-25 text-danger me-3">
                AS
              </div>
              <div>
                <p class="fw-semibold mb-0">Alice Smith</p>
                <div class="small text-muted">
                  <span class="text-warning">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                      class="fas fa-star"></i><i class="fas fa-star"></i>
                  </span>
                  <span class="ms-1">2 weeks ago</span>
                </div>
              </div>
            </div>
            <p class="text-secondary">"This is one of the best Python courses I've taken. The instructor is very
              knowledgeable and the projects were very helpful. Great content!"</p>
          </div>

        </div>
        <div class="mt-4 text-center">
          <p class="text-muted small">Tổng cộng {{formatNumber course.total_reviews}} đánh giá</p>
          <button class="btn btn-link fw-semibold text-decoration-none">Xem tất cả đánh giá</button>
        </div>
      </div>

    </div>
    {{!--
    Card mua hàng --}}
    <div class="col-lg-4">
      <div class="position-lg-sticky top-0" style="top: 2rem;">
        <div class="card shadow-lg rounded-3 overflow-hidden">

          <img src="{{course.image_url}}" alt="{{course.title}}" class="card-img-top card-img-top-custom">

          <div class="card-body p-4">
            <div class="d-flex align-items-baseline flex-wrap gap-2 mb-4">
              <span class="h2 fw-bold text-dark mb-0">{{formatNumber course.discount_price}}</span>
              {{#if (isGreater course.price course.discount_price)}}
              <span class="fs-5 text-muted text-decoration-line-through">{{formatNumber course.price}}</span>
              <span class="fs-6 fw-semibold text-danger">{{calculateDiscount course.price course.discount_price}}%
                off</span>
              {{/if}}
            </div>

            <div class="d-grid gap-2">
              <button class="btn btn-primary btn-lg fw-bold">Thêm vào giỏ hàng</button>
              <button class="btn btn-outline-dark btn-lg fw-bold">Mua ngay</button>
            </div>

            <p class="text-center text-muted small mt-3">Đảm bảo hoàn tiền trong 30 ngày</p>

            <hr>

            <div>
              <h3 class="h5 fw-bold mb-3">Khóa học này bao gồm:</h3>
              <ul class="list-unstyled d-flex flex-column gap-2 text-secondary">
                <li class="d-flex align-items-center">
                  <i class="fas fa-video fa-fw me-2 text-muted"></i>
                  <span>{{course.total_hours}} giờ video theo yêu cầu</span>
                </li>
                <li class="d-flex align-items-center">
                  <i class="fas fa-file-alt fa-fw me-2 text-muted"></i>
                  <span>{{course.total_lectures}} bài giảng</span>
                </li>
                <li class="d-flex align-items-center">
                  <i class="fas fa-signal fa-fw me-2 text-muted"></i>
                  <span>Cấp độ {{course.level}}</span>
                </li>
                <li class="d-flex align-items-center">
                  <i class="fas fa-trophy fa-fw me-2 text-muted"></i>
                  <span>Chứng chỉ hoàn thành</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>