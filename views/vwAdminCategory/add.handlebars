<div class="container-fluid mt-4">
  <div class="card">
    <div class="card-header">
      <h4 class="mb-0">
        <i class="bi bi-tags"></i> Thêm danh mục mới
      </h4>
    </div>
    
    {{#if error}}
    <div class="alert alert-danger mx-3 mt-3" role="alert">
      <i class="bi bi-exclamation-triangle"></i> {{error}}
    </div>
    {{/if}}
    
    <form action="/admin/categories/add" method="post">
      <div class="card-body">
        <div class="mb-3">
          <label for="txtCatname" class="form-label">Tên danh mục</label>
          <input type="text" class="form-control" id="txtCatname" name="catname" 
                 placeholder="Nhập tên danh mục..." required autofocus>
        </div>
      </div>

      <div class="card-footer">
        <a class="btn btn-outline-secondary" href="/admin/categories" role="button">
          <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <button type="submit" class="btn btn-primary ms-2">
          <i class="bi bi-check2"></i> Lưu danh mục
        </button>
      </div>
    </form>
  </div>
</div>