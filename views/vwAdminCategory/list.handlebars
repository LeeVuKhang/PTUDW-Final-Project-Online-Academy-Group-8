{{!-- float-end or d-flex justify-content-between align-items-center--}}
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-tags-fill"></i> Quản lý danh mục</h5>
        <a class="btn btn-primary float-end" href="/admin/categories/add" role="button"> <i class="bi bi-file-earmark-plus-fill"></i> Thêm danh mục</a>
    </div>
    <div class="card-body">
        <table class="table table-striped __web-inspector-hide-shortcut__">
            <thead>
                <tr>
                    <th scope="col">Danh mục</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                {{#each categories}}
                <!-- Danh mục cha -->
                <tr class="table-light" style="cursor: pointer;" onclick="toggleChildren({{cat_id}})">
                    <td>
                        <strong>
                            {{#if children}}
                                <i class="bi bi-chevron-right" id="icon-{{cat_id}}" style="transition: transform 0.3s ease; margin-right: 8px;"></i>
                            {{else}}
                                <span style="margin-right: 20px;"></span>
                            {{/if}}
                            <i class="bi bi-folder-fill"></i> {{cat_name}}
                        </strong>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/admin/categories/edit?id={{cat_id}}" role="button" onclick="event.stopPropagation()" title="Chỉnh sửa">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form method="POST" action="/admin/categories/delete" style="display:inline;" onclick="event.stopPropagation()">
                            <input type="hidden" name="cat_id" value="{{cat_id}}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa danh mục" {{#if children}}disabled{{/if}} onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?')">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                
                <!-- Danh mục con (ẩn ban đầu) -->
                {{#if children}}
                {{#each children}}
                <tr id="child-{{../cat_id}}-{{@index}}" style="display: none;">
                    <td class="ps-4"> {{cat_name}}</td>
                    <td class="text-end"></td>
                </tr>
                {{/each}}
                {{/if}}
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted">Footer</div>
</div>

<script>
function toggleChildren(categoryId) {
    // Tìm tất cả các row con của category này
    const childRows = document.querySelectorAll(`[id^="child-${categoryId}-"]`);
    const icon = document.getElementById(`icon-${categoryId}`);
    
    if (childRows.length > 0) {
        // Kiểm tra trạng thái hiện tại
        const isHidden = childRows[0].style.display === 'none';
        
        // Toggle hiển thị tất cả các row con
        childRows.forEach(row => {
            row.style.display = isHidden ? 'table-row' : 'none';
        });
        
        // Xoay icon
        if (icon) {
            icon.style.transform = isHidden ? 'rotate(90deg)' : 'rotate(0deg)';
        }
    }
}


</script>