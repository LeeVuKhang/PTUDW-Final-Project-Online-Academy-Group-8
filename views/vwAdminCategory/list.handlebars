{{! Quản lý danh mục - Xem danh sách }}
<div class="container-fluid mt-4">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h4 class="mb-0">
        <i class="bi bi-tags"></i> Quản lý danh mục
      </h4>
      <div class="d-flex align-items-center gap-3">
        <span class="badge bg-primary">{{categories.length}} danh mục</span>
        <a class="btn btn-primary btn-sm" href="/admin/categories/add" role="button">
          <i class="bi bi-plus-circle"></i> Thêm danh mục
        </a>
      </div>
    </div>
    
    <div class="card-body">
      <!-- Search -->
      <div class="row mb-3">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control" id="searchCategory" placeholder="Tìm kiếm danh mục...">
          </div>
        </div>
      </div>

      <!-- Categories Table -->
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th scope="col" width="80">#</th>
              <th scope="col">Tên danh mục</th>
              <th scope="col" width="200" class="text-center">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            {{#each categories}}
            <tr>
              <td>{{catid}}</td>
              <td>
                <strong>{{catname}}</strong>
              </td>
              <td class="text-center">
                <div class="btn-group" role="group">
                  <a href="/admin/categories/edit?id={{catid}}" class="btn btn-outline-primary btn-sm" title="Chỉnh sửa">
                    <i class="bi bi-pencil"></i> Sửa
                  </a>
                  <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteCategory({{catid}})" title="Xóa">
                    <i class="bi bi-trash"></i> Xóa
                  </button>
                </div>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="3" class="text-center text-muted py-4">
                <i class="bi bi-folder-x fs-1"></i>
                <p class="mt-2">Chưa có danh mục nào</p>
                <a href="/admin/categories/add" class="btn btn-primary">
                  <i class="bi bi-plus-circle"></i> Thêm danh mục đầu tiên
                </a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
    
    <div class="card-footer">
      <small class="text-muted">
        <i class="bi bi-info-circle"></i> 
        Tổng cộng: <strong>{{categories.length}}</strong> danh mục
      </small>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Xác nhận xóa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Bạn có chắc chắn muốn xóa danh mục này không?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-danger" id="confirmDelete">Xóa</button>
      </div>
    </div>
  </div>
</div>

<script>
// Search functionality
document.getElementById('searchCategory').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('tbody tr');
    
    rows.forEach(row => {
        const categoryName = row.cells[1]?.textContent.toLowerCase();
        if (categoryName && categoryName.includes(searchTerm)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
});

// Delete functionality
let categoryToDelete = null;

function deleteCategory(id) {
    categoryToDelete = id;
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
}

document.getElementById('confirmDelete').addEventListener('click', function() {
    if (categoryToDelete) {
        // Create form and submit
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/admin/categories/delete';
        
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'id';
        input.value = categoryToDelete;
        
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }
});
</script>