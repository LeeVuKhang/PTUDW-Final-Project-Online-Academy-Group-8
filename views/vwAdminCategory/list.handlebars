{{!-- float-end or d-flex justify-content-between align-items-center--}}
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-tags-fill"></i> Quản lý danh mục</h5>
        <a class="btn btn-primary float-end" href="/admin/categories/add" role="button"> <i class="bi bi-file-earmark-plus-fill"></i> Thêm danh mục</a>
    </div>
    <div class="card-body">
        <table class="table table-striped __web-inspector-hide-shortcut__">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Danh mục</th>
                    <th scope="col" class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                {{#each categories}}
                <tr>
                    <th scope="row">{{cat_id}}</th>
                    <td>{{cat_name}}</td>
                    <td class="text-end">
                        <a name="" id="" class="btn btn-sm btn-outline-primary" href="/admin/categories/edit?id={{cat_id}}" role="button"><i class="bi bi-pencil-fill"></i> Chỉnh sửa</a>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted">Footer</div>
</div>