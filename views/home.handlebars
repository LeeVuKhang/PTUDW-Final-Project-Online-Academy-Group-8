{{#fill_section 'css'}}
<style>
  .course-card .card-img-top {
    height: 180px;
    object-fit: cover;
  }
  .card-title-hover:hover {
    color: var(--bs-primary) !important;
  }
  .btn-watchlist {
    font-size: 1.25rem;
    line-height: 1;
  }
  .course-card .card-body {
    padding: 1rem;
  }
</style>
{{/fill_section}}

<div class="container-fluid p-0">
    <div id="carouselExampleDark" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="0" class="active"
                aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="1"
                aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="2"
                aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="4000">
                <img src="/static/carousel1.jpg" class="d-block w-100 carousel-img" alt="slide 1">
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                     <h1 class="fw-bold display-4 text-white">Khám phá khoá học hàng đầu</h1>
                    <p class="lead text-light mb-4">Cập nhật liên tục, học từ chuyên gia thật — trải nghiệm học tập hiện
                        đại.</p>
                   <a href="/course" class="btn btn-lg btn-outline-primary px-4 rounded-pill shadow">Bắt đầu học
                        ngay</a>
                </div>
            </div>

            <div class="carousel-item" data-bs-interval="4000">
                <img src="/static/carousel2.jpg" class="d-block w-100 carousel-img" alt="slide 2">
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                    <h1 class="fw-bold display-4 text-white">Phát triển kỹ năng của bạn</h1>
                    <p class="lead text-light mb-4">Từ lập trình, thiết kế, đến kỹ năng mềm — tất cả trong tầm tay bạn.
                    </p>
                    <a href="/course" class="btn btn-lg btn-outline-light px-4 rounded-pill shadow">Khám phá danh
                        mục</a>
                </div>
            </div>

            <div class="carousel-item" data-bs-interval="4000">
                <img src="/static/carousel3.jpg" class="d-block w-100 carousel-img" alt="slide 3">
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                    <h1 class="fw-bold display-4 text-white">Học mọi lúc, mọi nơi</h1>
                    <p class="lead text-light mb-4">Truy cập từ mọi thiết bị — học linh hoạt theo 
                    nhịp của bạn.</p>
                    <a href="/account/signup" class="btn btn-lg btn-outline-warning px-4 rounded-pill shadow">Tham gia
                        ngay</a>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Tiếp</span>
        </button>
    </div>
</div>

<section class="container my-4 px-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
         <h3 class="fw-bold text-primary">Khám phá danh mục</h3>
    </div>
    <div class="d-flex flex-wrap gap-3">
        {{#each parents}}
        <a href="/course/byCat?id={{cat_id}}"
            class="btn btn-outline-primary rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-folder2-open"></i>
            <span class="fw-semibold">{{cat_name}}</span>
        </a>
         {{/each}}
         <a href="/course/"
            class="btn btn-outline-primary rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-folder2-open"></i>
            <span class="fw-semibold">Xem tất cả</span>
        </a>
    </div>
</section>

<section class="container my-3 px-5">
    <h3 class="fw-bold mb-4 text-center">💬 Đánh giá từ học viên</h3>
    <div class="row g-4">
        {{#each rating}}
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-1 rounded-4 p-3">
                <div class="d-flex align-items-center mb-3">
                    <img src="https://i.pravatar.cc/80?img={{@index}}" alt="avatar" class="rounded-circle me-3"
                         width="60" height="60">
                    <div>
                        <h6 class="mb-0 fw-semibold">{{student_name}}</h6>
                        <small class="text-muted">Học viên khoá học “{{title}}”</small>
                     </div>
                </div>
                <p class="fst-italic">"{{comment}}"</p>
                <div class="text-warning small">
                    {{{renderStars value}}}
                </div>
             </div>
        </div>
        {{/each}}
        <div class="px-5">
            <h3 class="border-bottom mt-5"></h3>
        </div>
    </div>
</section>

<section class="container my-3 px-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="fw-bold text-primary">🔥 Khóa học được xem nhiều nhất</h3>
        <a href="/course" class="btn btn-outline-primary px-4 rounded-pill">Xem tất cả</a>
    </div>
    <div id="mostViewsCoursesCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            {{#each mostViewsCourses}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <div class="row g-3">
                    {{#each this}}
                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card course-card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                            <a href="/course/details/{{this.course_id}}">
                                <img src="{{this.image_url}}" class="card-img-top" alt="{{this.title}}">
                            </a>
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <a href="/course/details/{{this.course_id}}" class="text-decoration-none flex-grow-1">
                                        <h6 class="fw-bold text-dark card-title-hover mb-1">{{this.title}}</h6>
                                    </a>
                                    {{#if ../../isAuthenticated}}
                                        {{#if this.isInWatchlist}}
                                            <form action="/account/watchlist/remove" method="POST" class="d-inline-block m-0 ms-2">
                                                <input type="hidden" name="course_id" value="{{this.course_id}}">
                                                <button type="submit" class="btn btn-link text-danger p-0 btn-watchlist" title="Xóa khỏi Watchlist"><i class="bi bi-heart-fill"></i></button>
                                            </form>
                                        {{else}}
                                            <form action="/account/watchlist/add" method="POST" class="d-inline-block m-0 ms-2">
                                                <input type="hidden" name="course_id" value="{{this.course_id}}">
                                                <button type="submit" class="btn btn-link text-secondary p-0 btn-watchlist" title="Thêm vào Watchlist"><i class="bi bi-heart"></i></button>
                                            </form>
                                        {{/if}}
                                    {{else}}
                                        <form action="/account/watchlist/add" method="POST" class="d-inline-block m-0 ms-2">
                                            <input type="hidden" name="course_id" value="{{this.course_id}}">
                                            <button type="submit" class="btn btn-link text-secondary p-0 btn-watchlist" title="Thêm vào Watchlist"><i class="bi bi-heart"></i></button>
                                        </form>
                                    {{/if}}
                                </div>
                                <a href="/course/instructorProfile?id={{this.instructor_id}}" class="text-muted small mb-1 text-decoration-none card-title-hover">Giảng viên: {{this.instructor_name}}</a>
                                <p class="text-muted small mb-2">Lĩnh vực: {{this.cat_name}}</p>
                                <div class="d-flex align-items-center mb-2">
                                    <span class="fw-bold text-dark me-1">{{formatRating this.avg_rating}}</span>
                                    <span class="text-warning me-2" style="font-size: 0.9rem;">{{{renderStars this.avg_rating}}}</span>
                                    <span class="text-muted small">({{this.rating_count}})</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <span class="fw-bold fs-6 text-primary">{{formatNumber this.discount_price}}</span>
                                        {{#if (isGreater this.price this.discount_price)}}
                                            <span class="text-muted text-decoration-line-through small">{{formatNumber this.price}}</span>
                                        {{/if}}
                                    </div>
                                    {{#if this.views}}
                                    <span class="text-muted small"><i class="bi bi-eye"></i> {{this.views}}</span>
                                    {{/if}}
                                </div>
                                <div class="d-grid gap-2 mt-auto">
                                    {{#if this.isEnrolled}}
                                        <a href="/course/learn/{{this.course_id}}" class="btn btn-primary w-100">
                                            <i class="bi bi-mortarboard"></i> Học ngay
                                        </a>
                                        <form action="/course/my-courses/remove/{{this.course_id}}" method="post" class="m-0">
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                <i class="bi bi-trash"></i> Xóa khóa học
                                            </button>
                                        </form>
                                    {{else}}
                                        <form action="/course/add-to-cart/{{this.course_id}}" method="post" class="m-0 form-add-to-cart">
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                            </button>
                                        </form>
                                        <form action="/course/buy-now/{{this.course_id}}" method="get" class="m-0">
                                            <button type="submit" class="btn btn-outline-dark w-100">
                                                <i class="bi bi-credit-card"></i> Mua ngay
                                            </button>
                                        </form>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
        <button class="carousel-control-prev custom-control" type="button" data-bs-target="#mostViewsCoursesCarousel"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon custom-icon"></span>
        </button>
        <button class="carousel-control-next custom-control" type="button" data-bs-target="#mostViewsCoursesCarousel"
            data-bs-slide="next">
            <span class="carousel-control-next-icon custom-icon"></span>
        </button>
    </div>
    <div class="px-5">
        <h3 class="border-bottom mt-5"></h3>
    </div>
</section>

