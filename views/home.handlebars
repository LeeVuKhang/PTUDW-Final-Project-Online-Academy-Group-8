<!--Slideshow-->
<div class="container-fluid p-0">
    <div id="carouselExampleDark" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="0" class="active"
                aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="1"
                aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="2"
                aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="4000">
                <img src="/static/carousel1.jpg" class="d-block w-100 carousel-img" alt="slide 1">
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                    <h1 class="fw-bold display-4 text-white">Khám phá khoá học hàng đầu</h1>
                    <p class="lead text-light mb-4">Cập nhật liên tục, học từ chuyên gia thật — trải nghiệm học tập hiện
                        đại.</p>
                    <a href="/course" class="btn btn-lg btn-outline-primary px-4 rounded-pill shadow">Bắt đầu học
                        ngay</a>
                </div>
            </div>

            <div class="carousel-item" data-bs-interval="4000">
                <img src="/static/carousel2.jpg" class="d-block w-100 carousel-img" alt="slide 2">
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                    <h1 class="fw-bold display-4 text-white">Phát triển kỹ năng của bạn</h1>
                    <p class="lead text-light mb-4">Từ lập trình, thiết kế, đến kỹ năng mềm — tất cả trong tầm tay bạn.
                    </p>
                    <a href="/categories" class="btn btn-lg btn-outline-light px-4 rounded-pill shadow">Khám phá danh
                        mục</a>
                </div>
            </div>

            <div class="carousel-item" data-bs-interval="4000">
                <img src="/static/carousel3.jpg" class="d-block w-100 carousel-img" alt="slide 3">
                <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100">
                    <h1 class="fw-bold display-4 text-white">Học mọi lúc, mọi nơi</h1>
                    <p class="lead text-light mb-4">Truy cập từ mọi thiết bị — học linh hoạt theo nhịp của bạn.</p>
                    <a href="/account/signup" class="btn btn-lg btn-outline-warning px-4 rounded-pill shadow">Tham gia
                        ngay</a>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Tiếp</span>
        </button>
    </div>
</div>

<section class="container my-4 px-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary">Khám phá danh mục</h3>
    </div>

    <div class="d-flex flex-wrap gap-3">
        {{#each parents}}
        <a href="/course/byCat?id={{cat_id}}"
            class="btn btn-outline-primary rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-folder2-open"></i>
            <span class="fw-semibold">{{cat_name}}</span>
        </a>
        {{/each}}
    </div>
</section>
<!-- ====== Khoá học nổi bật ====== -->
<section class="container-fluid mt-5 px-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">✨ Khóa học nổi bật trong tuần</h3>
        <a href="/course" class="btn btn-outline-primary px-4 rounded-pill">Xem tất cả</a>
    </div>
    <div class="row g-4 mb-3">
        {{#each impressiveCourses}}
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card h-100 border-1 shadow-sm rounded-4 course-card">
                <img src="{{image_url}}" class="card-img-top" alt="{{title}}">
                <div class="card-body">
                    <h6 class="card-title fw-semibold">{{title}}</h6>
                    <p class="text-muted mb-1">Giảng viên: <strong>{{instructor_name}}</strong></p>
                    <p class="text-muted mb-1">Lĩnh vực: {{#if category_name}}{{category_name}}{{else}}Chưa phân
                        loại{{/if}}<br></p>
                    <p class="text-primary fw-bold mb-2">
                        {{formatNumber discount_price}}
                        <span class="text-muted text-decoration-line-through">{{formatNumber price}}</span>
                    </p>
                    <div class="d-flex align-items-center small text-warning">
                        <span class="text-muted ms-2 mb-2">
                            <i class="bi bi-eye"></i> {{views}}
                        </span>
                    </div>
                    <a href="/course/details/{{course_id}}" class="btn btn-outline-primary mt-auto w-100">Xem chi
                        tiết</a>
                </div>
            </div>
        </div>
        {{/each}}


        <div class="px-5">
            <h3 class="border-bottom mt-2"></h3>
        </div>
    </div>
</section>

<!-- ====== Đánh giá ====== -->
<section class="container my-3 px-5">
    <h3 class="fw-bold mb-4 text-center">💬 Đánh giá từ học viên</h3>
    <div class="row g-4">
        {{#each rating}}
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-1 rounded-4 p-3">
                <div class="d-flex align-items-center mb-3">
                    <img src="https://i.pravatar.cc/80?img={{@index}}" alt="avatar" class="rounded-circle me-3"
                        width="60" height="60">
                    <div>
                        <h6 class="mb-0 fw-semibold">{{student_name}}</h6>
                        <small class="text-muted">Học viên khoá học “{{title}}”</small>
                    </div>
                </div>
                <p class="fst-italic">"{{comment}}"</p>
                <div class="text-warning small">
                    {{{renderStars value}}}
                </div>
            </div>
        </div>
        {{/each}}

        <div class="px-5">
            <h3 class="border-bottom mt-5"></h3>
        </div>
    </div>
</section>

<!-- ====== KHÓA HỌC XEM NHIỀU NHẤT ====== -->

<section class="container my-3 px-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="fw-bold text-primary">🔥 Khóa học được xem nhiều nhất</h3>
        <a href="/course" class="btn btn-outline-primary px-4 rounded-pill">Xem tất cả</a>
    </div>
    <div id="mostViewsCoursesCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            {{#each mostViewsCourses}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <div class="row g-3">
                    {{#each this}}
                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card h-100 border-1 shadow-sm rounded-4 course-card">
                            <img src="{{image_url}}" class="card-img-top" alt="{{title}}">
                            <div class="card-body">
                                <h6 class="card-title fw-semibold">{{title}}</h6>
                                <p class="text-muted mb-1">Giảng viên: <strong>{{instructor_name}}</strong></p>
                                <p class="text-muted mb-1">Lĩnh vực: {{#if category_name}}{{category_name}}{{else}}Chưa
                                    phân
                                    loại{{/if}}<br></p>
                                <p class="text-primary fw-bold mb-2">
                                    {{formatNumber discount_price}}
                                    <span class="text-muted text-decoration-line-through">{{formatNumber price}}</span>
                                </p>
                                <div class="d-flex align-items-center small text-warning">
                                    <span class="text-muted ms-2 mb-2">
                                        <i class="bi bi-eye"></i> {{views}}
                                    </span>
                                </div>
                                <a href="/course/details/{{course_id}}"
                                    class="btn btn-outline-primary mt-auto w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>

        <!-- Nút điều hướng -->
        <button class="carousel-control-prev custom-control" type="button" data-bs-target="#mostViewsCoursesCarousel"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon custom-icon"></span>
        </button>
        <button class="carousel-control-next custom-control" type="button" data-bs-target="#mostViewsCoursesCarousel"
            data-bs-slide="next">
            <span class="carousel-control-next-icon custom-icon"></span>
        </button>
    </div>
    <div class="px-5">
        <h3 class="border-bottom mt-5"></h3>
    </div>
</section>

<!-- ====== KHÓA HỌC MỚI NHẤT ====== -->
<section class="container my-3 px-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-success">🆕 Khóa học mới nhất</h3>
        <a href="/course" class="btn btn-outline-success px-4 rounded-pill">Khám phá</a>
    </div>

    <div id="newestCoursesCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            {{#each newestCourses}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <div class="row g-3">
                    {{#each this}}
                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card h-100 border-1 shadow-sm rounded-4 course-card">
                            <img src="{{image_url}}" class="card-img-top" alt="{{title}}">
                            <div class="card-body">
                                <h6 class="card-title fw-semibold">{{title}}</h6>
                                <p class="text-muted mb-1">Giảng viên: <strong>{{instructor_name}}</strong></p>
                                <p class="text-muted mb-1">Lĩnh vực: {{#if category_name}}{{category_name}}{{else}}Chưa
                                    phân
                                    loại{{/if}}<br></p>
                                <p class="text-primary fw-bold mb-2">
                                    {{formatNumber discount_price}}
                                    <span class="text-muted text-decoration-line-through">{{formatNumber price}}</span>
                                </p>
                                <div class="d-flex align-items-center small text-warning">
                                    <span class="text-muted ms-2 mb-2">
                                        <i class="bi bi-eye"></i> {{views}}
                                    </span>
                                </div>
                                <a href="/course/details/{{course_id}}"
                                    class="btn btn-outline-primary mt-auto w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>

        <!-- Nút điều hướng -->
        <button class="carousel-control-prev custom-control" type="button" data-bs-target="#newestCoursesCarousel"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon custom-icon"></span>
        </button>
        <button class="carousel-control-next custom-control" type="button" data-bs-target="#newestCoursesCarousel"
            data-bs-slide="next">
            <span class="carousel-control-next-icon custom-icon"></span>
        </button>
    </div>
    <div class="px-5">
        <h3 class="border-bottom mt-5"></h3>
    </div>
</section>

<!-- ====== LĨNH VỰC PHỔ BIẾN ====== -->
<section class="container my-5 px-5">
    <div class="text-center mb-4">
        <h3 class="fw-bold text-warning">🏆 Lĩnh vực được học nhiều nhất tuần qua</h3>
    </div>

    <div class="row g-4 justify-content-center">
        {{#each topCate}}
        <div class="col-md-4 col-sm-6">
            <div class="card h-100 border-1 shadow-sm rounded-4 course-card text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-mortarboard-fill text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <h5 class="card-title fw-semibold mb-2">{{cat_name}}</h5>
                    <p class="text-muted mb-0">
                        {{total_enrollments}} lượt học
                    </p>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</section>