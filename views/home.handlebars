</section>

<!-- ====== KHÓA HỌC XEM NHIỀU NHẤT ====== -->

<section class="container my-3 px-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="fw-bold text-primary">🔥 Khóa học được xem nhiều nhất</h3>
        <a href="/course" class="btn btn-outline-primary px-4 rounded-pill">Xem tất cả</a>
    </div>
    <div id="mostViewsCoursesCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            {{#each mostViewsCourses}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <div class="row g-3">
                    {{#each this}}
                    <div class="col-md-3 col-sm-4">
                        <div class="card h-100 border-1 shadow-sm course-card d-flex flex-column">
                            <img src="{{#if image_url}}{{image_url}}{{else}}https://picsum.photos/400/250?random={{course_id}}{{/if}}"
                                class="card-img-top" alt="{{title}}">

                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-semibold text-truncate">{{title}}</h6>
                                <p class="text-muted small mb-1 flex-grow-1">
                                    Lĩnh vực: {{#if category_name}}{{category_name}}{{else}}Chưa phân loại{{/if}}<br>
                                    Giảng viên: {{#if instructor_name}}{{instructor_name}}{{else}}Đang cập
                                    nhật{{/if}}<br>
                                    Lượt xem: {{views}}
                                </p>
                                <p class="fw-bold text-success mb-3">
                                    {{formatNumber discount_price}}
                                    {{#if discount_price}}
                                    <span class="text-decoration-line-through text-muted small">
                                        {{formatNumber price}}
                                    </span>
                                    {{/if}}
                                </p>
                                <a href="/course/details/{{course_id}}"
                                    class="btn btn-outline-primary mt-auto w-100">Xem chi tiết</a>
                            </div>
                        </div>

                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>

        <!-- Nút điều hướng -->
        <button class="carousel-control-prev custom-control" type="button" data-bs-target="#mostViewsCoursesCarousel"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon custom-icon"></span>
        </button>
        <button class="carousel-control-next custom-control" type="button" data-bs-target="#mostViewsCoursesCarousel"
            data-bs-slide="next">
            <span class="carousel-control-next-icon custom-icon"></span>
        </button>
    </div>
    <div class="px-5">
        <h3 class="border-bottom mt-5"></h3>
    </div>
</section>

