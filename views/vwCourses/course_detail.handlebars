{{#fill_section 'css'}}
.text-pre-wrap {
  white-space: pre-wrap;
}

.card-img-top-custom {
  height: 224px;
  object-fit: cover;
  background-color: #f8f9fa;
}

.avatar-circle {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.instructor-profile-box {
  margin-bottom: 3.5rem;
}

.instructor-title {
  font-size: 1rem;
  font-weight: 700;
  color: #563d7c;
  margin-bottom: 0.25rem;
  text-transform: uppercase;
}

.instructor-name {
  font-size: 1.75rem;
  font-weight: 700;
  color: #333;
  margin-bottom: 0.25rem;
}

.instructor-subtitle {
  font-size: 1rem;
  color: #555;
  margin-bottom: 1rem;
}

.instructor-avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 1rem;
}

.instructor-stats {
  list-style: none;
  padding-left: 0;
  font-size: 0.95rem;
}

.instructor-stats li {
  display: flex;
  align-items: center;
  margin-bottom: 0.75rem;
  color: #212529;
}

.instructor-stats i {
  font-size: 1.1rem;
  color: #111;
  width: 28px;
  margin-right: 0.75rem;
}

.instructor-bio {
  margin-top: 1.5rem;
}

.instructor-bio h4 {
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.instructor-bio .bio-content p {
  font-size: 1rem;
  line-height: 1.6;
}
{{/fill_section}}

{{#fill_section 'js'}}
{{/fill_section}}

<div class="bg-dark text-white py-5 shadow-inner">
  <div class="container">
    <div class="text-sm fw-semibold mb-2">
      <a href="/categories/{{course.catid}}" class="text-info text-decoration-none">
        {{course.category_name}}
      </a>
    </div>

    <h1 class="display-4 fw-bold mb-3">{{course.title}}</h1>
    <p class="fs-5 text-white-50 mb-4">{{course.tinydes}}</p>

    <div class="d-flex flex-wrap align-items-center small gap-3 text-white-50">
      <div class="d-flex align-items-center gap-1">
        <span class="fw-bold text-warning">{{course.rating}}</span>
        <span class="text-warning">{{{renderStars course.rating}}}</span>
        <span>({{formatNumber course.total_reviews}} đánh giá)</span>
      </div>
      <span>{{formatNumber course.student_count}} học viên</span>
    </div>

    <div class="d-flex flex-wrap align-items-center small gap-3 text-white-50 mt-2">
      <span class="badge rounded-pill bg-secondary">{{course.level}}</span>
      <span>Tổng cộng {{course.total_hours}} giờ</span>
      <span>{{course.total_lectures}} bài giảng</span>
    </div>
  </div>
</div>

<div class="container mt-5">
  <div class="row">

    <!-- CỘT TRÁI -->
    <div class="col-lg-8">

      <!-- Video -->
      <div class="shadow rounded-3 mb-4 ratio ratio-16x9 bg-dark">
        <iframe
          src="https://www.youtube.com/embed/GxmfcnU3feo"
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>

      <!-- Mô tả -->
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Mô tả khóa học</h2>
        <p class="text-secondary leading-relaxed text-pre-wrap">
          {{{course.fulldes}}}
        </p>
      </div>

      <!-- Nội dung -->
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Nội dung khóa học</h2>

        {{#if chapters.length}}
          <div class="accordion" id="courseAccordion">
            {{#each chapters}}
              <div class="accordion-item">
                <h2 class="accordion-header" id="heading{{@index}}">
                  <button
                    class="accordion-button fs-5 fw-semibold {{#unless @first}}collapsed{{/unless}}"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse{{@index}}"
                    aria-expanded="{{#if @first}}true{{else}}false{{/if}}"
                    aria-controls="collapse{{@index}}">
                    {{this.title}}
                  </button>
                </h2>

                <div
                  id="collapse{{@index}}"
                  class="accordion-collapse collapse {{#if @first}}show{{/if}}"
                  aria-labelledby="heading{{@index}}"
                  data-bs-parent="#courseAccordion">
                  <div class="accordion-body">
                    <ul class="list-group list-group-flush">
                      {{#each this.lessons}}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div>
                            <i class="fas fa-play-circle text-primary me-2"></i>
                            <span>{{this.title}}</span>
                          </div>

                          {{#if ../../isEnrolled}}
                            <a href="/course/learn/{{../../course.course_id}}/{{this.lesson_id}}"
                               class="btn btn-sm btn-outline-primary">Học ngay</a>
                          {{else if this.is_preview}}
                            <a href="/course/learn/{{../../course.course_id}}/{{this.lesson_id}}"
                               class="btn btn-sm btn-outline-success">Xem thử</a>
                          {{else}}
                            <button class="btn btn-sm btn-secondary" disabled>
                              <i class="fas fa-lock"></i> Khoá
                            </button>
                          {{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="text-muted">Chưa có nội dung cho khóa học này.</p>
        {{/if}}
      </div>

      <!-- Đánh giá -->
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Đánh giá của học viên</h2>

        {{#if isEnrolled}}
          <form action="/course/rate/{{course.course_id}}" method="post" class="mb-5">
            <div class="mb-3">
              <label class="form-label fw-semibold">Chọn số sao</label>
              <select name="value" class="form-select" required>
                <option value="5">⭐⭐⭐⭐⭐ - Xuất sắc</option>
                <option value="4">⭐⭐⭐⭐ - Tốt</option>
                <option value="3">⭐⭐⭐ - Trung bình</option>
                <option value="2">⭐⭐ - Kém</option>
                <option value="1">⭐ - Rất tệ</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Nhận xét của bạn</label>
              <textarea
                name="comment"
                rows="3"
                class="form-control"
                placeholder="Viết cảm nhận của bạn về khóa học..."
                required></textarea>
            </div>

            <button type="submit" class="btn btn-primary fw-semibold">Gửi đánh giá</button>
          </form>
        {{else}}
          <p class="text-muted fst-italic">
            Bạn cần ghi danh khóa học trước khi có thể đánh giá.
          </p>
        {{/if}}

        <hr class="my-4">

        {{#if ratings.length}}
          <div class="vstack gap-4">
            {{#each ratings}}
              <div class="border-bottom pb-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="avatar-circle rounded-circle bg-primary bg-opacity-25 text-primary me-3">
                    {{substr name 0 2}}
                  </div>
                  <div>
                    <p class="fw-semibold mb-0">{{name}}</p>
                    <div class="small text-warning">{{{renderStars value}}}</div>
                  </div>
                </div>
                <p class="text-secondary mb-0">"{{comment}}"</p>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="text-muted">Chưa có đánh giá nào cho khóa học này.</p>
        {{/if}}
      </div>

      <!-- Giảng viên -->
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">Thông tin giảng viên</h2>

        {{#if instructor}}
          <div class="instructor-profile-box">
            <div class="d-flex align-items-center mb-3">
              <img src="{{instructor.image_url}}" alt="{{instructor.name}}" class="instructor-avatar me-3">
              <div>
                <h4 class="instructor-name mb-0">
                  <a href="/course/instructorProfile?id={{instructor.user_id}}"
                     class="text-decoration-none text-dark hover:text-primary">
                    {{instructor.name}}
                  </a>
                </h4>
                <p class="instructor-subtitle mb-0">Giảng viên tại CourseCademy</p>
              </div>
            </div>

            <div class="row text-center">
              <div class="col-6 col-md-3 mb-3">
                <i class="bi bi-star-fill text-warning fs-4 mb-1"></i>
                <div class="fw-semibold">{{instructor.avg_rating}}</div>
                <div class="text-muted small">Rating</div>
              </div>
              <div class="col-6 col-md-3 mb-3">
                <i class="bi bi-patch-check-fill text-success fs-4 mb-1"></i>
                <div class="fw-semibold">{{instructor.total_reviews}}</div>
                <div class="text-muted small">Reviews</div>
              </div>
              <div class="col-6 col-md-3 mb-3">
                <i class="bi bi-people-fill text-primary fs-4 mb-1"></i>
                <div class="fw-semibold">{{instructor.total_students}}</div>
                <div class="text-muted small">Students</div>
              </div>
              <div class="col-6 col-md-3 mb-3">
                <i class="bi bi-play-circle-fill text-danger fs-4 mb-1"></i>
                <div class="fw-semibold">{{instructor.total_courses}}</div>
                <div class="text-muted small">Courses</div>
              </div>
            </div>

            <div class="instructor-bio">
              <h4>Giới thiệu</h4>
              <div class="bio-content">
                {{{instructor.bio}}}
                {{#unless instructor.bio}}
                  <p>Chào mừng!</p>
                  <p>Tôi là <strong>{{instructor.name}}</strong>, một giảng viên tại CourseCademy.</p>
                  <p class="text-muted small">(Giảng viên chưa cập nhật tiểu sử.)</p>
                {{/unless}}
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-muted fst-italic">Chưa có thông tin giảng viên.</p>
        {{/if}}
      </div>

      <!-- Khóa học liên quan -->
      <div class="bg-white p-4 p-md-5 shadow-sm rounded-3 mb-4">
        <h2 class="h3 fw-bold mb-4">5 khóa học khác cùng lĩnh vực được mua nhiều nhất</h2>

        {{#if relatedCourses.length}}
          <div class="row g-3">
            {{#each relatedCourses}}
              <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0">
                  <img src="{{image_url}}" class="card-img-top" style="height:150px; object-fit:cover;" alt="{{title}}">
                  <div class="card-body">
                    <h6 class="fw-semibold">{{title}}</h6>
                    <p class="text-muted small mb-1">{{formatNumber discount_price}} đ</p>
                    <a href="/course/details/{{course_id}}" class="btn btn-sm btn-outline-primary w-100">
                      Xem chi tiết
                    </a>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="text-muted">Không có khóa học liên quan nào khác.</p>
        {{/if}}
      </div>
    </div>

    <!-- CỘT PHẢI -->
    <div class="col-lg-4">
      <div class="position-lg-sticky top-0" style="top: 2rem;">
        <div class="card shadow-lg rounded-3 overflow-hidden">
          <img src="{{course.image_url}}" alt="{{course.title}}" class="card-img-top card-img-top-custom">

          <div class="card-body p-4">
            <div class="d-flex align-items-baseline flex-wrap gap-2 mb-4">
              <span class="h2 fw-bold text-dark mb-0">{{formatNumber course.discount_price}}</span>
              {{#if (isGreater course.price course.discount_price)}}
                <span class="fs-5 text-muted text-decoration-line-through">{{formatNumber course.price}}</span>
                <span class="fs-6 fw-semibold text-danger">
                  {{calculateDiscount course.price course.discount_price}}% off
                </span>
              {{/if}}
            </div>

            <div class="d-grid gap-2">
              {{#if isEnrolled}}
                <a href="/course/learn/{{course.course_id}}" class="btn btn-success btn-lg fw-bold w-100">
                  Học ngay
                </a>
              {{else}}
                <form action="/course/add-to-cart/{{course.course_id}}" method="post">
                  <button type="submit" class="btn btn-primary btn-lg fw-bold w-100 mb-2">
                    🛒 Thêm vào giỏ hàng
                  </button>
                </form>
                <form action="/course/buy-now/{{course.course_id}}" method="get">
                  <button type="submit" class="btn btn-outline-dark btn-lg fw-bold w-100">
                    💳 Mua ngay
                  </button>
                </form>
              {{/if}}
            </div>

            <p class="text-center text-muted small mt-3">
              Đảm bảo hoàn tiền trong 30 ngày
            </p>

            <hr>

            <div>
              <h3 class="h5 fw-bold mb-3">Khóa học này bao gồm:</h3>
              <ul class="list-unstyled d-flex flex-column gap-2 text-secondary">
                <li class="d-flex align-items-center">
                  <i class="fas fa-video fa-fw me-2 text-muted"></i>
                  <span>{{course.total_hours}} giờ video theo yêu cầu</span>
                </li>
                <li class="d-flex align-items-center">
                  <i class="fas fa-file-alt fa-fw me-2 text-muted"></i>
                  <span>{{course.total_lectures}} bài giảng</span>
                </li>
                <li class="d-flex align-items-center">
                  <i class="fas fa-signal fa-fw me-2 text-muted"></i>
                  <span>Cấp độ {{course.level}}</span>
                </li>
                <li class="d-flex align-items-center">
                  <i class="fas fa-trophy fa-fw me-2 text-muted"></i>
                  <span>Chứng chỉ hoàn thành</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
