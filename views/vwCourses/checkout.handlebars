{{#fill_section 'css'}}
.checkout-summary {
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.05);
  padding: 2rem;
}
{{/fill_section}}

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="checkout-summary">
        <h1 class="mb-4 fw-bold">💳 Thanh toán khóa học</h1>

        <div class="d-flex gap-4 align-items-center mb-4">
          <img src="{{course.image_url}}" alt="{{course.title}}" 
               class="rounded shadow-sm" style="width: 160px; height: 100px; object-fit: cover;">
          <div>
            <h4 class="fw-bold mb-2">{{course.title}}</h4>
            <p class="text-muted mb-1">{{course.category_name}}</p>
            <span class="badge bg-secondary">{{course.level}}</span>
          </div>
        </div>

        <hr>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <span class="fs-5 fw-semibold">Giá gốc:</span>
          <span class="text-decoration-line-through text-muted">{{formatNumber course.price}}</span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <span class="fs-5 fw-semibold text-success">Giảm còn:</span>
          <span class="fs-4 fw-bold text-success">{{formatNumber course.discount_price}}</span>
        </div>

        <form action="/course/checkout/{{course.course_id}}" method="post">
          <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
            ✅ Xác nhận thanh toán
          </button>
        </form>

        <p class="text-center text-muted small mt-3">Bạn sẽ được chuyển đến trang học sau khi thanh toán thành công.</p>
      </div>
    </div>
  </div>
</div>
