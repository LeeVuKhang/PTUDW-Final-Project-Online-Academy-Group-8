{{!< main}}

{{#fill_section "css"}}
  .card-img-top-custom { height: 120px; object-fit: cover; background-color: #f8f9fa; }
{{/fill_section}}

<div class="container mt-5">
  <h1 class="mb-4">🛒 Giỏ hàng của bạn</h1>

  {{#if items.length}}
    <div class="row g-3">
      {{#each items}}
        <div class="col-12">
          <div class="card shadow-sm d-flex flex-row align-items-center p-3">
            <img
              src="{{this.image_url}}"
              class="card-img-top card-img-top-custom me-3"
              style="width:120px;"
              alt="{{this.title}}"
            />

            <div class="flex-grow-1">
              <h5 class="card-title mb-1">{{this.title}}</h5>
              <p class="mb-1 fw-bold text-primary">{{formatNumber this.discount_price}}</p>
            </div>

            <div class="d-flex align-items-center gap-3"> 
              <a
                href="/course/checkout/{{this.course_id}}"
                class="btn btn-success" 
              >
                💳 Thanh toán
              </a>

              <form
                action="/course/cart/remove/{{this.cart_item_id}}"
                method="post"
                class="m-0"
              >
                <button type="submit" class="btn btn-danger">🗑️ Xóa</button> 
              </form>
            </div>
          </div>
        </div>
      {{/each}}
    </div>

    <form action="/course/cart/checkout" method="post" class="mt-4">
      <button type="submit" class="btn btn-primary btn-lg w-100">💳 Thanh toán
        tất cả</button>
    </form>

  {{else}}
    <p class="text-muted fst-italic">Giỏ hàng của bạn đang trống.</p>
    <a href="/course" class="btn btn-primary">Xem khóa học</a>
  {{/if}}
</div>