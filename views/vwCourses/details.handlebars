{{#fill_section "js"}}
  <script>
    // JS cho nút enroll hoặc đánh giá
    document.addEventListener('DOMContentLoaded', () => { const enrollBtn =
    document.querySelector('#btnEnroll'); if (enrollBtn) {
    enrollBtn.addEventListener('click', () => {
    document.querySelector('#frmEnroll').submit(); }); } });
  </script>
{{/fill_section}}

<div class="bg-dark text-white py-5 mb-4 shadow-sm">
  <div class="container">
    <p class="mb-1 small">
      <a
        href="/categories/{{course.catid}}"
        class="text-info text-decoration-none"
      >
        {{course.category_name}}
      </a>
    </p>
    <h1 class="fw-bold mb-2">{{course.title}}</h1>
    <p class="lead text-light mb-3">{{course.tinydes}}</p>
    <div class="d-flex flex-wrap gap-3 small text-light">
      <div>
        <span class="fw-bold text-warning">{{course.rating}}</span>
        {{{renderStars course.rating}}}
        <span class="text-secondary">({{formatNumber course.total_reviews}}
          đánh giá)</span>
      </div>
      <span>{{formatNumber course.student_count}} học viên</span>
      <span class="badge bg-secondary">{{course.level}}</span>
      <span>{{course.total_hours}}
        giờ •
        {{course.total_lectures}}
        bài giảng</span>
    </div>
  </div>
</div>

<div class="container mb-5">
  <div class="row">
    <!-- LEFT CONTENT -->
    <div class="col-lg-8 mb-4">

      <!-- VIDEO -->
      <div
        class="bg-dark bg-opacity-10 rounded-3 p-4 mb-4 text-center aspect-ratio-16x9 d-flex flex-column justify-content-center"
      >
        <i class="bi bi-play-circle display-4 text-secondary mb-2"></i>
        <p class="fw-semibold text-secondary mb-0">Video giới thiệu khóa học</p>
        <small class="text-muted">(Placeholder)</small>
      </div>

      <!-- DESCRIPTION -->
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h4 class="fw-bold mb-3">Mô tả khóa học</h4>
          <p
            class="text-secondary mb-0"
            style="white-space: pre-wrap;"
          >{{course.fulldes}}</p>
        </div>
      </div>

      <!-- COURSE CONTENT -->
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h4 class="fw-bold mb-3">Nội dung khóa học</h4>
          {{#each lessons}}
            <div class="accordion mb-2" id="accordion{{@index}}">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed fw-semibold"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse{{@index}}"
                  >
                    {{this.title}}
                  </button>
                </h2>
                <div
                  id="collapse{{@index}}"
                  class="accordion-collapse collapse"
                >
                  <div class="accordion-body">
                    <ul class="list-unstyled mb-0">
                      {{#each this.lessons}}
                        <li class="d-flex align-items-center mb-1">
                          <i class="bi bi-play-fill text-secondary me-2"></i>
                          {{this.name}}
                        </li>
                      {{/each}}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      </div>

      <!-- RATINGS -->
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h4 class="fw-bold mb-3">Đánh giá của học viên</h4>
          {{#if ratings.length}}
            {{#each ratings}}
              <div class="border-bottom pb-3 mb-3">
                <div class="d-flex align-items-center mb-2">
                  <div
                    class="rounded-circle bg-light text-primary fw-bold d-flex align-items-center justify-content-center me-3"
                    style="width: 40px; height: 40px;"
                  >
                    {{substr username 0 2}}
                  </div>
                  <div>
                    <p class="mb-0 fw-semibold">{{username}}</p>
                    <small class="text-muted">
                      {{{renderStars value}}}
                      •
                      {{moment create_time "fromNow"}}
                    </small>
                  </div>
                </div>
                <p class="text-secondary mb-0">{{comment}}</p>
              </div>
            {{/each}}
          {{else}}
            <p class="text-muted">Chưa có đánh giá nào cho khóa học này.</p>
          {{/if}}

          {{#if isEnrolled}}
            <form
              action="/courses/rate/{{course.course_id}}"
              method="post"
              class="mt-4"
            >
              <label class="form-label fw-semibold">Đánh giá khóa học của bạn</label>
              <div class="mb-3">
                <select name="value" class="form-select w-auto">
                  <option value="5">⭐⭐⭐⭐⭐ - Xuất sắc</option>
                  <option value="4">⭐⭐⭐⭐ - Tốt</option>
                  <option value="3">⭐⭐⭐ - Trung bình</option>
                  <option value="2">⭐⭐ - Kém</option>
                  <option value="1">⭐ - Rất tệ</option>
                </select>
              </div>
              <div class="mb-3">
                <textarea
                  name="comment"
                  rows="3"
                  class="form-control"
                  placeholder="Viết nhận xét của bạn..."
                ></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
            </form>
          {{/if}}
        </div>
      </div>

    </div>

    <!-- RIGHT SIDEBAR -->
    <div class="col-lg-4">
      <div class="sticky-top" style="top: 80px;">
        <div class="card shadow-lg">
          <img
            src="{{course.image_url}}"
            class="card-img-top"
            alt="{{course.title}}"
          />
          <div class="card-body">
            <div class="d-flex align-items-baseline mb-3">
              <h3 class="fw-bold text-dark me-2">{{formatNumber
                  course.discount_price
                }}₫</h3>
              {{#if (isGreater course.price course.discount_price)}}
                <span
                  class="text-decoration-line-through text-muted me-2"
                >{{formatNumber course.price}}₫</span>
                <span class="text-danger fw-semibold">{{calculateDiscount
                    course.price
                    course.discount_price
                  }}% OFF</span>
              {{/if}}
            </div>

            {{#if isEnrolled}}
              <a
                href="/courses/learn/{{course.course_id}}/{{lessons.0.lesson_id}}"
                class="btn btn-success w-100 mb-2"
              >
                Tiếp tục học
              </a>
            {{else}}
              {{#if isAuthenticated}}
                <a
                  href="/courses/enroll/{{course.course_id}}"
                  class="btn btn-primary w-100 mb-2"
                >
                  Ghi danh ngay
                </a>
              {{else}}
                <a href="/account/signin" class="btn btn-primary w-100 mb-2">
                  Đăng nhập để ghi danh
                </a>
              {{/if}}
            {{/if}}

            <small class="d-block text-center text-muted mb-3">Hoàn tiền trong
              30 ngày</small>
            <hr />
            <h6 class="fw-bold mb-3">Khóa học này bao gồm:</h6>
            <ul class="list-unstyled small text-secondary">
              <li><i class="bi bi-camera-video me-2"></i>{{course.total_hours}}
                giờ video</li>
              <li><i
                  class="bi bi-file-earmark-text me-2"
                ></i>{{course.total_lectures}}
                bài giảng</li>
              <li><i class="bi bi-bar-chart me-2"></i>Cấp độ:
                {{course.level}}</li>
              <li><i class="bi bi-patch-check me-2"></i>Chứng chỉ hoàn thành</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>