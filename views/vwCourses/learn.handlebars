{{!< main}}

{{#fill_section 'css'}}
.card-video {
  aspect-ratio: 16 / 9;
  background-color: #000;
}
.lesson-active {
  background-color: #007bff !important;
  color: white !important;
}
.rating i {
  color: #f5c518;
  cursor: pointer;
}
{{/fill_section}}

<div class="container-fluid mt-4">
  <div class="row">
    <!-- VIDEO PLAYER -->
    <div class="col-md-9">
      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h4>{{course.title}}</h4>
          <h6 class="text-muted">{{currentLesson.title}}</h6>

          <!-- Video -->
          <div class="card-video mt-3">
            <div class="ratio ratio-16x9">
              <iframe
                id="player"
                src="https://www.youtube.com/embed/{{extractYouTubeId currentLesson.video_url}}"
                title="{{currentLesson.title}}"
                allowfullscreen>
              </iframe>
            </div>
          </div>

          <!-- Rating Form -->
          {{#if isStudent}}
          <div class="mt-4 border-top pt-3">
            <h5>Đánh giá của học viên</h5>
            <form id="ratingForm" class="mt-3">
              <label class="form-label">Chọn số sao</label>
              <div class="border rounded p-2 mb-2 d-flex align-items-center justify-content-between" id="star-container">
                <div>
                  {{#each (range 1 5)}}
                    <i 
                      class="bi {{#if (lte this ../userRating)}}bi-star-fill{{else}}bi-star{{/if}}"
                      data-value="{{this}}">
                    </i>
                  {{/each}}
                </div>
                <span id="rating-text" class="text-muted ms-2">
                  {{#if userRating}}
                    {{lookup (array "Tệ" "Không hài lòng" "Bình thường" "Tốt" "Xuất sắc") (minus userRating 1)}}
                  {{/if}}
                </span>
              </div>

              <label class="form-label mt-2">Nhận xét của bạn</label>
              <textarea class="form-control mb-2" id="comment" placeholder="Hãy chia sẻ cảm nhận của bạn..." rows="3">{{userComment}}</textarea>

              <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
              <small id="rating-msg" class="text-success ms-2" style="display:none;">Cảm ơn bạn đã đánh giá!</small>
            </form>
          </div>
          {{/if}}

          <!-- Rating List -->
          <div class="mt-4">
            {{#each ratings}}
              <div class="border-bottom pb-2 mb-2">
                <strong>{{this.name}}</strong> – {{{renderStars this.value}}}  
                <div>{{this.comment}}</div>
                <small class="text-muted">{{moment this.create_time "fromNow"}}</small>
              </div>
            {{/each}}
          </div>

        </div>
      </div>
    </div>

    <!-- LESSON LIST -->
    <div class="col-md-3">
      <div class="accordion" id="lessonAccordion">
        {{#each chapters}}
        <div class="accordion-item">
          <h2 class="accordion-header" id="heading{{chapter_id}}">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
              data-bs-target="#collapse{{chapter_id}}" aria-expanded="false" aria-controls="collapse{{chapter_id}}">
              {{title}}
            </button>
          </h2>
          <div id="collapse{{chapter_id}}" class="accordion-collapse collapse"
            aria-labelledby="heading{{chapter_id}}" data-bs-parent="#lessonAccordion">
            <div class="accordion-body p-0">
              <ul class="list-group list-group-flush">
                {{#each lessons}}
                <a href="/course/learn/{{../course_id}}/{{lesson_id}}"
                  class="list-group-item list-group-item-action {{#if (eq lesson_id ../../currentLesson.lesson_id)}}lesson-active{{/if}}">
                  {{title}}
                </a>
                {{/each}}
              </ul>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>

{{#section 'js'}}
<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
<script src="https://cdn.plyr.io/3.7.2/plyr.js"></script>
<link rel="stylesheet" href="https://cdn.plyr.io/3.7.2/plyr.css" />

<script>
document.addEventListener('DOMContentLoaded', () => {
  const player = new Plyr('#player');
  const courseId = {{course.course_id}};
  const lessonId = {{currentLesson.lesson_id}};

  const updateProgress = async () => {
    try {
      const response = await fetch('/course/update-last-watch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          course_id: courseId,
          lesson_id: lessonId
        })
      });
      if (!response.ok) {
          const errorData = await response.json();
          console.error('Lỗi lưu tiến độ (phản hồi server):', errorData.error);
      } else {
          const data = await response.json();
          if (data.success) {
            console.log(' Đã lưu tiến độ học:', lessonId, 'Progress:', data.progress !== null ? data.progress + '%' : 'N/A');
          } else {
            console.error('Lỗi lưu tiến độ (server báo lỗi):', data.error);
          }
      }
    } catch (err) {
      console.error(' Lỗi fetch khi lưu tiến độ:', err);
    }
  };

  player.on('ready', updateProgress);
  window.addEventListener('beforeunload', updateProgress);

  const stars = document.querySelectorAll('#star-container i');
  let currentRating = Number({{userRating}});
  const ratingText = document.getElementById('rating-text');
  const ratingLabels = ["Tệ", "Không hài lòng", "Bình thường", "Tốt", "Xuất sắc"];
  const updateStars = (value) => {
    stars.forEach(s => {
      if (Number(s.dataset.value) <= value) {
        s.classList.add('bi-star-fill');
        s.classList.remove('bi-star');
      } else {
        s.classList.add('bi-star');
        s.classList.remove('bi-star-fill');
      }
    });
    ratingText.textContent = value > 0 ? `- ${ratingLabels[value - 1]}` : "";
  };
  stars.forEach(star => {
    star.addEventListener('click', () => {
      currentRating = Number(star.dataset.value);
      updateStars(currentRating);
    });
  });
  const ratingForm = document.getElementById('ratingForm');
  if (ratingForm) {
      ratingForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const comment = document.getElementById('comment').value;
        const ratingMsg = document.getElementById('rating-msg');
        try {
            const response = await fetch(`/course/rate/${courseId}`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ value: currentRating, comment })
            });
            const data = await response.json();
            if (data.success) {
                ratingMsg.textContent = 'Cảm ơn bạn đã đánh giá!';
                ratingMsg.style.display = 'inline';
            } else {
                ratingMsg.textContent = data.error || 'Lỗi gửi đánh giá.';
                ratingMsg.className = 'text-danger ms-2'; 
                ratingMsg.style.display = 'inline';
            }
        } catch (err) {
            ratingMsg.textContent = 'Lỗi kết nối khi gửi đánh giá.';
            ratingMsg.className = 'text-danger ms-2';
            ratingMsg.style.display = 'inline';
        }
    });
  }
  updateStars(currentRating);
});
</script>
{{/section}}