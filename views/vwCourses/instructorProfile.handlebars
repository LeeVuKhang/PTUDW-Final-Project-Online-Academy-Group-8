{{#fill_section 'css'}}
<style>
  .instructor-header {
    background-color: #f8f9fa;
    border-radius: .5rem;
  }
  .list-group-item .course-thumbnail {
    width: 100px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
  }
</style>
{{/fill_section}}

<div class="container my-5">
  <div class="row">
    <div class="col-lg-10 mx-auto">

      <div class="instructor-header p-4 p-md-5 mb-5 text-center">
        <h1 class="display-5 fw-bold">{{instructor.name}}</h1>
        <p class="fs-5 text-muted">{{instructor.email}}</p>
        <p class="text-dark">Giảng viên tại CourseCademy</p>
      </div>

      <h2 class="fw-bold mb-4">Các khóa học của {{instructor.name}}</h2>
      
      <div class="list-group shadow-sm">
        {{#each courses}}
          <a href="/course/details/{{this.course_id}}" class="list-group-item list-group-item-action p-3">
            <div class="row align-items-center g-3">
              <div class="col-auto">
                <img src="{{this.image_url}}" alt="{{this.title}}" class="course-thumbnail">
              </div>
              <div class="col">
                <h5 class="mb-1 fw-semibold">{{this.title}}</h5>
                <p class="mb-1 text-muted small">{{this.tinydes}}</p>
              </div>
              <div class="col-md-2 text-md-end">
                <h6 class="text-primary fw-bold mb-0">{{formatNumber this.discount_price}}</h6>
              </div>
            </div>
          </a>
        {{else}}
          <div class="list-group-item p-4 text-center text-muted">
            Giảng viên này chưa đăng tải khóa học nào.
          </div>
        {{/each}}
      </div>
      
    </div>
  </div>
</div>