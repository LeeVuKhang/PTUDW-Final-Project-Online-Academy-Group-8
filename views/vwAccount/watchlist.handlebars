<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <style>
    .course-thumbnail { width: 120px; height: 80px; object-fit: cover; border-radius: 4px; }
    .list-group-item:hover { background-color: #f8f9fa; }
    .action-form { display: inline-block; margin-left: 8px; }
  </style>
</head>

<body class="bg-light">
  <div class="container my-5">
    <div class="row">
      <div class="col-lg-12">
        <div class="card shadow-sm">
          
          <div class="card-header bg-white py-3">
            <h3 class="mb-0">Danh sách yêu thích (Watchlist)</h3>
          </div>

          <div class="card-body p-0">
            <div class="list-group list-group-flush" id="watchlistContainer">
              
              {{#each watchlistItems}}
              <div class="list-group-item course-item">
                <div class="row align-items-center">
                  
                  <div class="col-auto">
                    <img src="{{this.image_url}}" class="course-thumbnail" alt="{{this.title}}">
                  </div>

                  <div class="col">
                    <h5 class="mb-1 course-title">{{this.title}}</h5>
                    <p class="mb-1 text-muted course-description">{{this.tinydes}}</p>
                    <small class="text-muted">
                      <span><i class="bi bi-person"></i> {{this.instructor_name}}</span>
                      <span class="ms-3"><i class="bi bi-star-fill text-warning"></i> {{formatRating this.avg_rating}} ({{this.rating_count}} đánh giá)</span>
                      <span class="ms-3"><i class="bi bi-people-fill"></i> {{this.student_count}} học viên</span>
                    </small>
                  </div>

                  <div class="col-md-2 text-end">
                    <h5 class="text-dark fw-bold mb-0">{{formatNumber this.discount_price}}</h5>
                    {{#if (isGreater this.price this.discount_price)}}
                      <s class="text-muted">{{formatNumber this.price}}</s>
                    {{/if}}
                  </div>

                  <div class="col-auto">
                    <div class="d-flex gap-2 flex-wrap justify-content-end">
                      <a href="/course/details/{{this.course_id}}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Chi tiết
                      </a>

                      <form class="action-form" method="POST" action="/account/watchlist/remove">
                        <input type="hidden" name="course_id" value="{{this.course_id}}">
                        
                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                onclick="return confirm('Bạn có chắc chắn muốn xóa khóa học này khỏi danh sách yêu thích?');">
                          <i class="bi bi-trash"></i> Xóa
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              {{else}}
                <div id="noResults" class="text-center py-5">
                  <i class="bi bi-heart text-muted" style="font-size: 3rem;"></i>
                  <p class="text-muted mt-3">Watchlist của bạn đang trống.</p>
                  <a href="/" class="btn btn-primary">Khám phá các khóa học</a>
                </div>
              {{/each}}
              
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>