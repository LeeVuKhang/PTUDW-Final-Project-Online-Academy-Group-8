{{#fill_section 'js'}}
<script>
  async function signinWithGoogle() {
    try {
      if (!window.supabase) {
        alert('Supabase client not found.'); return;
      }
      const { error } = await window.supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/account/oauth-done' }
      });
      if (error) { console.error(error); alert('Google sign-in failed.'); }
    } catch (e) { console.error(e); alert('Unexpected error with Google sign-in.'); }
  }
</script>
{{/fill_section}}


<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
      <div class="card shadow-sm">
        <h5 class="card-header">Sign in</h5>
        <div class="card-body">

          {{#if err}}
            <div class="alert alert-danger py-2 mb-3">{{err}}</div>
          {{/if}}


          <form method="post" action="/account/signin" id="frmSignin" novalidate>
          <input type="hidden" name="retUrl" value="{{retUrl}}">
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input class="form-control" name="username" required value="{{lastUsername}}">
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <label class="form-label">Password</label>
                
              </div>
              <input type="password" class="form-control" name="password" required>
            </div>
            <div class="mb-3 justify-content-end d-flex">
                <a class="link-primary small" href="/account/forgot">Forgot password?</a>
            </div>

            <button class="btn btn-primary w-100">Sign in</button>


                        <div class="d-flex align-items-center my-3">
              <div class="flex-grow-1" style="height:1px; background:#e9ecef;"></div>
              <div class="px-3 text-muted small">or</div>
              <div class="flex-grow-1" style="height:1px; background:#e9ecef;"></div>
            </div>
              
            <div class="mb-3">
              <button type="button" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2"
                      onclick="signinWithGoogle()">
                <i class="bi bi-google"></i>
                Continue with Google
              </button>
            </div>

          </form>
        </div>
      </div>


      <div class="text-center mt-3">
        <a class="link-secondary" href="/account/signup">Sign up</a>
      </div>
    </div>
  </div>
</div>


