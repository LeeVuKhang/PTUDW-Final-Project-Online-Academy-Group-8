<div class="container my-4">
      <h3 class="mb-0">Account details</h3>
  <div class="d-flex align-items-baseline gap-3 mb-5">
    <span class="text-muted username-large">@{{user.username}}</span>
  </div>

  <ul class="nav nav-tabs" id="accountTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if (eq tab 'info')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-info" type="button" role="tab">
        Personal info
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if (eq tab 'pwd')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-pwd" type="button" role="tab">
        Change password
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if (eq tab 'email')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-email" type="button" role="tab">
        Change email
      </button>
    </li>
    {{#if pendingEmail}}
      <li class="nav-item" role="presentation">
        <button class="nav-link {{#if (eq tab 'email-verify-old')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-email-verify-old" type="button" role="tab">
          Verify old email
        </button>
      </li>
      {{#if (eq pendingStage 'new')}}
        <li class="nav-item" role="presentation">
          <button class="nav-link {{#if (eq tab 'email-verify-new')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-email-verify-new" type="button" role="tab">
            Verify new email
          </button>
        </li>
      {{/if}}
    {{/if}}
  </ul>

  <div class="tab-content border border-top-0 p-3">
    <div id="pane-info" class="tab-pane fade {{#if (eq tab 'info')}}show active{{/if}}">
      {{#if saved}}<div class="alert alert-success py-2">Profile updated.</div>{{/if}}
      <form method="post" action="/account/profile" class="row g-3">
        <div class="col-12">
          <label class="form-label">Full name</label>
          <input class="form-control" name="name" value="{{user.name}}" required>
        </div>

        <div class="col-12">
          <label class="form-label">Email</label>
          <div class="input-group">
            <input class="form-control" type="email" value="{{user.email}}" readonly>
            <a class="btn btn-outline-secondary" href="/account/profile?tab=email">Change</a>
          </div>
          <div class="form-text">Email is your unique ID. Use the Change Email tab.</div>
        </div>

        <div class="col-12">
          <label for="txtdob" class="form-label">Date of Birth</label>
          <input id="txtdob" class="form-control" type="date" name="dob" value="{{formatDate user.dob}}">
        </div>

        <div class="col-12">
          <label for="profileImageUrlInput" class="form-label">Profile Image URL</label>
          <input type="url" id="profileImageUrlInput" name="image_url" class="form-control"
                 placeholder="https://example.com/profile-image.jpg" value="{{user.image_url}}">
          <div class="form-text">Enter a valid image URL. The preview will update below.</div>
          <div class="mt-3 text-center">
              {{#if user.image_url}}
                <img id="profileImagePreview" src="{{user.image_url}}" alt="Profile Image Preview"
                     class="rounded-circle shadow-sm border"
                     style="width: 150px; height: 150px; object-fit: cover; background-color: #f8f9fa;"
                     onerror="handleProfileImageError(this)">
              {{else}}
                <img id="profileImagePreview" src="https://via.placeholder.com/150?text=Preview" alt="Profile Image Preview"
                     class="rounded-circle shadow-sm border"
                     style="width: 150px; height: 150px; object-fit: cover; background-color: #f8f9fa;">
              {{/if}}
              <p id="profileImageError" class="mt-2 small text-danger fw-medium" style="display: none;">
                  <i class="fas fa-exclamation-triangle me-1"></i> Cannot load image preview.
              </p>
          </div>
        </div>

        <div class="col-12">
         <label for="self_introduction_profile" class="form-label">Self Introduction</label>
         <textarea id="self_introduction_profile" name="self_introduction" rows="4" class="form-control"
                   placeholder="Tell us a bit about yourself... (optional)">{{user.self_introduction}}</textarea>
         <div class="form-text">A brief bio about yourself.</div>
       </div>

        <div class="col-12">
          <button class="btn btn-primary">Save changes</button>
        </div>
      </form>
    </div>
    <div id="pane-pwd" class="tab-pane fade {{#if (eq tab 'pwd')}}show active{{/if}}">
      {{#if error}}<div class="alert alert-danger py-2">Current password is incorrect.</div>{{/if}}
      <form method="post" action="/account/change-pwd" class="row g-3" onsubmit="return checkPwdMatchA()">
        <div class="col-12 d-flex justify-content-between align-items-center">
          <label class="form-label mb-0">Current password</label>
          <a class="link-primary" href="/account/forgot">Forgot password?</a>
        </div>
        <div class="col-12">
          <input class="form-control" type="password" name="currentPassword" required>
        </div>

        <div class="col-12">
          <label class="form-label">New password</label>
          <input id="newPwdA" class="form-control" type="password" name="newPassword" minlength="6" required>
          <div class="form-text">At least 6 characters.</div>
        </div>

        <div class="col-12">
          <label class="form-label">Confirm new password</label>
          <input id="confirmPwdA" class="form-control" type="password" minlength="6" required>
        </div>

        <div class="col-12">
          <button class="btn btn-primary">Update password</button>
        </div>
      </form>
    </div>
    <div id="pane-email" class="tab-pane fade {{#if (eq tab 'email')}}show active{{/if}}">
      {{#if errEmail}}<div class="alert alert-danger py-2">{{errEmail}}</div>{{/if}}
      <form method="post" action="/account/change-email" class="row g-3">
        <div class="col-12">
          <label class="form-label">New email</label>
          <input class="form-control" type="email" name="newEmail" required>
          <div class="form-text">We’ll send a code to your current email ({{user.email}}) first.</div>
        </div>
        <div class="col-12">
          <button class="btn btn-primary">Send code to current email</button>
        </div>
      </form>
    </div>

    <!-- Verify old email -->
    {{#if pendingEmail}}
      <div id="pane-email-verify-old" class="tab-pane fade {{#if (eq tab 'email-verify-old')}}show active{{/if}}">
        {{#if errEmailVerifyOld}}<div class="alert alert-danger py-2">{{errEmailVerifyOld}}</div>{{/if}}
        <p>We sent a 6-digit code to your current email <strong>{{user.email}}</strong>.</p>
        <form method="post" action="/account/change-email/verify-old" class="row g-3">
          <div class="col-12">
            <label class="form-label">Verification code</label>
            <input class="form-control" name="code" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required>
          </div>
          <div class="col-12">
            <button class="btn btn-primary">Verify current email</button>
          </div>
        </form>
        <hr>
        <p class="text-muted mb-0">Next step (after this): we’ll send a code to your new email <strong>{{pendingEmail}}</strong>.</p>
      </div>
    {{/if}}

    <!-- Verify new email -->
    {{#if (eq pendingStage 'new')}}
      <div id="pane-email-verify-new" class="tab-pane fade {{#if (eq tab 'email-verify-new')}}show active{{/if}}">
        {{#if errEmailVerifyNew}}<div class="alert alert-danger py-2">{{errEmailVerifyNew}}</div>{{/if}}
        <p>We sent a 6-digit code to your new email <strong>{{pendingEmail}}</strong>.</p>
        <form method="post" action="/account/change-email/verify-new" class="row g-3">
          <div class="col-12">
            <label class="form-label">Verification code</label>
            <input class="form-control" name="code" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required>
          </div>
          <div class="col-12">
            <button class="btn btn-primary">Confirm new email</button>
          </div>
        </form>
      </div>
    {{/if}}
  </div>
</div>

<script>
function checkPwdMatchA() {
  const a = document.getElementById('newPwdA').value;
  const b = document.getElementById('confirmPwdA').value;
  if (a !== b) { alert('New passwords do not match.'); return false; }
  return true;
}
   function handleProfileImageError(img) {
     img.src = 'https://via.placeholder.com/150?text=Preview'; 
     const imageError = document.getElementById('profileImageError');
     if (imageError) imageError.style.display = 'block';
   }
 
   document.addEventListener('DOMContentLoaded', function() {
     const imageUrlInput = document.getElementById('profileImageUrlInput');
     const imagePreview = document.getElementById('profileImagePreview');
 
     if (imageUrlInput && imagePreview) {
       imageUrlInput.addEventListener('input', function() {
         const url = this.value;
         const imageError = document.getElementById('profileImageError');
         if (url) {
           imagePreview.src = url;
           if (imageError) imageError.style.display = 'none'; // Ẩn lỗi khi nhập mới
         } else {
           imagePreview.src = 'https://via.placeholder.com/150?text=Preview'; // Mặc định nếu rỗng
           if (imageError) imageError.style.display = 'none';
         }
       });
     }
   });
</script>
