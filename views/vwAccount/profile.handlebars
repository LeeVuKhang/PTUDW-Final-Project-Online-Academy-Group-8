<div class="container my-4">
  <h3 class="mb-3">Account details</h3>

  <ul class="nav nav-tabs" id="accountTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if (eq tab 'info')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-info" type="button" role="tab">
        Personal info
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if (eq tab 'pwd')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-pwd" type="button" role="tab">
        Change password
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link {{#if (eq tab 'email')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-email" type="button" role="tab">
        Change email
      </button>
    </li>
    {{#if pendingEmail}}
      <li class="nav-item" role="presentation">
        <button class="nav-link {{#if (eq tab 'email-verify')}}active{{/if}}" data-bs-toggle="tab" data-bs-target="#pane-email-verify" type="button" role="tab">
          Verify email
        </button>
      </li>
    {{/if}}
  </ul>

  <div class="tab-content border border-top-0 p-3">
    <div id="pane-info" class="tab-pane fade {{#if (eq tab 'info')}}show active{{/if}}">
      {{#if saved}}<div class="alert alert-success py-2">Profile updated.</div>{{/if}}
      <form method="post" action="/account/profile" class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Full name</label>
          <input class="form-control" name="name" value="{{user.name}}" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Email</label>
          <div class="input-group">
            <input class="form-control" type="email" value="{{user.email}}" readonly>
            <a class="btn btn-outline-secondary" href="/account/profile?tab=email">Change</a>
          </div>
        </div>
        <div class="col-md-6">
          <label for="txtdob" class="form-label">Date of Birth</label>
          <input id="txtdob" class="form-control" type="date" name="dob" value="{{formatDate user.dob}}">
        </div>
        <div class="col-12">
          <button class="btn btn-primary">Save changes</button>
        </div>
      </form>
    </div>
    <div id="pane-pwd" class="tab-pane fade {{#if (eq tab 'pwd')}}show active{{/if}}">
  {{#if user.isSocial}}
    {{#if pwdSent}}
      {{#if errPwd}}<div class="alert alert-danger py-2">{{errPwd}}</div>{{/if}}
      <form method="post" action="/account/change-pwd-social" class="row g-3" onsubmit="return checkPwdMatch()">
        <div class="col-md-4">
          <label class="form-label">Verification code</label>
          <input class="form-control" name="code" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">New password</label>
          <input id="newPwd" class="form-control" type="password" name="newPassword" minlength="8" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Confirm new password</label>
          <input id="confirmPwd" class="form-control" type="password" minlength="8" required>
        </div>
        <div class="col-12">
          <button class="btn btn-primary">Set password</button>
        </div>
      </form>
    {{else}}
      {{#if errPwd}}<div class="alert alert-danger py-2">{{errPwd}}</div>{{/if}}
      <p>Since you signed in with Google, you don’t have a local password yet. We’ll verify by sending a code to <strong>{{user.email}}</strong>.</p>
      <form method="post" action="/account/change-pwd-social/send">
        <button class="btn btn-primary">Send code</button>
      </form>
    {{/if}}
  {{else}}
    {{#if error}}<div class="alert alert-danger py-2">Current password is incorrect.</div>{{/if}}
    <form method="post" action="/account/change-pwd" class="row g-3" onsubmit="return checkPwdMatch()">
      <div class="col-md-6">
        <label class="form-label">Current password</label>
        <input class="form-control" type="password" name="currentPassword" required>
      </div>
      <div class="col-md-6"></div>
      <div class="col-md-6">
        <label class="form-label">New password</label>
        <input id="newPwd" class="form-control" type="password" name="newPassword" minlength="8" required>
        <div class="form-text">At least 8 characters.</div>
      </div>
      <div class="col-md-6">
        <label class="form-label">Confirm new password</label>
        <input id="confirmPwd" class="form-control" type="password" minlength="8" required>
      </div>
      <div class="col-12">
        <button class="btn btn-primary">Update password</button>
      </div>
    </form>
  {{/if}}
</div>
    <div id="pane-email" class="tab-pane fade {{#if (eq tab 'email')}}show active{{/if}}">
  {{#if errEmail}}<div class="alert alert-danger py-2">{{errEmail}}</div>{{/if}}
  <form method="post" action="/account/change-email" class="row g-3">
    {{#unless user.isSocial}}
      <div class="col-md-6">
        <label class="form-label">Current password</label>
        <input class="form-control" type="password" name="currentPassword" required>
      </div>
    {{/unless}}
    <div class="{{#if user.isSocial}}col-md-6{{else}}col-md-6{{/if}}">
      <label class="form-label">New email</label>
      <input class="form-control" type="email" name="newEmail" required>
      <div class="form-text">We’ll send a 6-digit code to your current email ({{user.email}}). (tbh ts is just for show nothing actually being sent to email but actually pre generated inside console )</div>
    </div>
    <div class="col-12">
      <button class="btn btn-primary">Send code</button>
    </div>
  </form>
</div>
    {{#if pendingEmail}}
      <div id="pane-email-verify" class="tab-pane fade {{#if (eq tab 'email-verify')}}show active{{/if}}">
        {{#if errEmailVerify}}<div class="alert alert-danger py-2">{{errEmailVerify}}</div>{{/if}}
        <p>We sent a 6-digit code to <strong>{{pendingEmail}}</strong>. Enter it below. (tbh ts is just for show nothing actually being sent to email but actually pre generated inside console )</p>
        <form method="post" action="/account/change-email/verify" class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Verification code</label>
            <input class="form-control" name="code" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required>
          </div>
          <div class="col-12">
            <button class="btn btn-primary">Verify & Update</button>
          </div>
        </form>
      </div>
    {{/if}}
  </div>
</div>

<script>
function checkPwdMatch() {
  const a = document.getElementById('newPwd').value;
  const b = document.getElementById('confirmPwd').value;
  if (a !== b) { alert('New passwords do not match.'); return false; }
  return true;
}
</script>
