{{#fill_section 'css'}}
body {
background-color: #f8f9fa;
}
.ql-editor { font-size: 1.2rem; }
.ql-editor.ql-blank::before { font-size: 1.2rem; }

#dropZoneContainer {
    position: relative;
    border: 2px dashed #adb5bd;
    border-radius: .5rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
}
#dropZoneContainer:hover,
#dropZoneContainer.drop-zone--over {
    background-color: #e9ecef;
    border-color: #0d6efd;
}
#dropZoneOverlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #495057;
    font-weight: 500;
    pointer-events: none; /* Cho phép click xuyên qua */
}
#profileImagePreview {
    opacity: 1;
    transition: opacity 0.2s ease;
}
#dropZoneContainer.drop-zone--over #profileImagePreview {
    opacity: 0.3;
}
#uploadSpinner {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}
#dropZoneContainer.is-uploading #profileImagePreview {
    opacity: 0.3;
}
#dropZoneContainer.is-uploading #uploadSpinner {
    display: block;
}
{{/fill_section}}

<div class="container my-4">
      <h3 class="mb-0">Account details</h3>
  <div class="d-flex align-items-baseline gap-3 mb-5">
    <span class="text-muted username-large">@{{user.username}}</span>
  </div>

  <ul class="nav nav-tabs" id="accountTabs" role="tablist">
  </ul>

  <div class="tab-content border border-top-0 p-3">
    <div id="pane-info" class="tab-pane fade {{#if (eq tab 'info')}}show active{{/if}}">
      {{#if saved}}<div class="alert alert-success py-2">Profile updated.</div>{{/if}}
      <form method="post" action="/account/profile" class="row g-3" id="frmProfileInfo">
        <div class="col-12">
          <label class="form-label">Full name</label>
          <input class="form-control" name="name" value="{{user.name}}" required>
        </div>

        <div class="col-12">
          <label class="form-label">Email</label>
           <div class="input-group">
            <input class="form-control" type="email" value="{{user.email}}" readonly>
            <a class="btn btn-outline-secondary" href="/account/profile?tab=email">Change</a>
          </div>
          <div class="form-text">Email is your unique ID. Use the Change Email tab.</div>
        </div>

        <div class="col-12">
          <label for="txtdob" class="form-label">Date of Birth</label>
          <input id="txtdob" class="form-control" type="date" name="dob" value="{{formatDate user.dob}}">
        </div>

        <div class="col-12">
          <label for="profileImageUrlInput" class="form-label">Profile Image</label>
          <input type="text" id="profileImageUrlInput" name="image_url" class="form-control"
            placeholder="Kéo thả ảnh vào khung bên dưới, hoặc dán URL vào đây" value="{{user.image_url}}">
          <div class="form-text">Enter a valid image URL or drag & drop a file below.</div>
          <div id="dropZoneContainer" class="mt-3 text-center p-3">
              <div id="dropZoneOverlay">
                  <i class="bi bi-upload fs-1"></i>
                  <span>Enter a valid image URL or drag & drop a file below.</span>
                  <small class="text-muted">(Or click to browse)</small>
              </div>
              <img id="profileImagePreview" src="{{#if user.image_url}}{{user.image_url}}{{else}}https://via.placeholder.com/150?text=Preview{{/if}}" alt="Profile Image Preview"
                   class="rounded-circle shadow-sm border"
                   style="width: 150px; height: 150px; object-fit: cover; background-color: #f8f9fa; position: relative; z-index: 1;"
                   onerror="handleProfileImageError(this)">
               <div class="spinner-border text-primary" role="status" id="uploadSpinner">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p id="profileImageError" class="mt-2 small text-danger fw-medium" style="display: none;">
                  <i class="fas fa-exclamation-triangle me-1"></i> Cannot load image preview or upload failed.
              </p>
              <input type="file" id="fileInput" accept="image/*" class="d-none">
          </div>
        </div>

       <div class="col-12">
            <label class="form-label fs-6 fw-semibold"> Self Introduction <span class="text-danger">*</span>
            </label>
            <div id="editor" style="height: 250px;">
                {{{user.self_introduction}}}
            </div>
            <input type="hidden" id="self_introduction_hidden" name="self_introduction">
            <div class="form-text">A brief bio about yourself.</div>
        </div>

        <div class="col-12">
          <button class="btn btn-primary">Save changes</button>
        </div>
      </form>
    </div> 
  </div>
</div>

<script>
function checkPwdMatchA() {
  const a = document.getElementById('newPwdA').value;
  const b = document.getElementById('confirmPwdA').value;
  if (a !== b) { alert('New passwords do not match.'); return false; }
  return true;
}
   function handleProfileImageError(img) {
     img.src = 'https://via.placeholder.com/150?text=Preview'; 
     const imageError = document.getElementById('profileImageError');
     if (imageError) imageError.style.display = 'block';
   }
</script>
{{#fill_section 'js'}}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (document.getElementById('editor')) {
      const toolbarOptions = [
        ['bold', 'italic', 'underline'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'header': [1, 2, 3, false] }],
        ['clean']
      ];
      const quill = new Quill('#editor', {
        modules: { toolbar: toolbarOptions },
        theme: 'snow'
      });
      const form = document.getElementById('frmProfileInfo');
      const hiddenInput = document.getElementById('self_introduction_hidden');
      if (form && hiddenInput) {
        form.addEventListener('submit', function() {
          const htmlContent = quill.root.innerHTML;
          if (htmlContent === '<p><br></p>') {
            hiddenInput.value = '';
          } else {
            hiddenInput.value = htmlContent;
          }
        });
      }
    }
    const dropZone = document.getElementById('dropZoneContainer');
    const fileInput = document.getElementById('fileInput');
    const imageUrlInput = document.getElementById('profileImageUrlInput');
    const imagePreview = document.getElementById('profileImagePreview');
    const imageError = document.getElementById('profileImageError');

    if (dropZone && fileInput && imageUrlInput && imagePreview && imageError) {
      
      dropZone.addEventListener('click', (e) => {
          if (e.target.id !== 'profileImagePreview') { 
            fileInput.click();
          }
      });
      fileInput.addEventListener('change', () => {
          if (fileInput.files.length > 0) {
              uploadFile(fileInput.files[0]);
          }
      });

       imageUrlInput.addEventListener('input', function () {
         const url = this.value;
         if (imageError) imageError.style.display = 'none';
         if (url) {
           imagePreview.src = url;
         } else {
           imagePreview.src = 'https://via.placeholder.com/150?text=Preview';
         }
       });

      dropZone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropZone.classList.add('drop-zone--over');
      });
      ['dragleave', 'dragend'].forEach(type => {
          dropZone.addEventListener(type, () => {
              dropZone.classList.remove('drop-zone--over');
          });
      });
      dropZone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropZone.classList.remove('drop-zone--over');
          if (e.dataTransfer.files.length > 0) {
              uploadFile(e.dataTransfer.files[0]);
          }
      });

      async function uploadFile(file) {
          dropZone.classList.add('is-uploading');
          imageError.style.display = 'none';
          
          const formData = new FormData();
          formData.append('avatar', file);

          try {
              const response = await fetch('/account/upload-avatar', {
                  method: 'POST',
                  body: formData
              });
              
              const data = await response.json();

              if (response.ok && data.success) {
                  imagePreview.src = data.newImageUrl + '?t=' + new Date().getTime();
                  imageUrlInput.value = data.newImageUrl;
              } else {
                  throw new Error(data.message || 'Upload failed');
              }
          } catch (error) {
              console.error('Upload error:', error);
              imageError.textContent = error.message;
              imageError.style.display = 'block';
          } finally {
              dropZone.classList.remove('is-uploading');
          }
      }
    }

  });
</script>
{{/fill_section}}