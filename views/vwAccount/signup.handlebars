<div class="container my-4">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

      <div class="card shadow-sm">
        <h5 class="card-header">Đăng ký tài khoản</h5>

        <div class="card-body">

          <div class="mb-3">
            <button type="button" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2"
                    onclick="signupWithGoogle()">
              <i class="bi bi-google"></i>
              Tiếp tục với tài khoản Google
            </button>
          </div>

          <div class="d-flex align-items-center my-3">
            <div class="flex-grow-1" style="height:1px; background:#e9ecef;"></div>
            <div class="px-3 text-muted small">hoặc tạo với email</div>
            <div class="flex-grow-1" style="height:1px; background:#e9ecef;"></div>
          </div>

          <form method="post" action="/account/signup" id="frmRegister" novalidate>
            <div class="mb-3">
              <label for="txtUsername" class="form-label">Tài khoản</label>
              <input type="text" class="form-control {{#if fieldErrors.username}}is-invalid{{/if}}"
                     id="txtUsername" name="username" required value="{{last.username}}">
              <div class="form-text">Tối thiểu 3 ký tự.</div>
              {{#if fieldErrors.username}}
                <div class="invalid-feedback d-block">{{fieldErrors.username}}</div>
              {{/if}}
            </div>
            <div class="mb-3">
              <label for="txtPassword" class="form-label">Mật khẩu</label>
              <input type="password" class="form-control {{#if fieldErrors.password}}is-invalid{{/if}}"
                     id="txtPassword" name="password" required minlength="6">
              <div class="form-text">Tối thiểu 6 ký tự.</div>
              {{#if fieldErrors.password}}
                <div class="invalid-feedback d-block">{{fieldErrors.password}}</div>
              {{/if}}
            </div>

            <div class="mb-3">
              <label for="txtConfirm" class="form-label">Xác nhận mật khẩu</label>
              <input type="password" class="form-control {{#if fieldErrors.confirm}}is-invalid{{/if}}"
                     id="txtConfirm" name="confirm" required minlength="6">
               {{#if fieldErrors.confirm}}
                <div class="invalid-feedback d-block">{{fieldErrors.confirm}}</div>
              {{/if}}
            </div>

            <hr class="my-4">
            <h5 class="mb-3">Thông tin</h5>


            <div class="mb-3">
              <label for="txtName" class="form-label">Tên đầy đủ</label>
              <input type="text" class="form-control {{#if fieldErrors.name}}is-invalid{{/if}}"
                     id="txtName" name="name" required value="{{last.name}}">
              {{#if fieldErrors.name}}
                <div class="invalid-feedback d-block">{{fieldErrors.name}}</div>
               {{/if}}
            </div>

            <div class="mb-3">
              <label for="txtEmail" class="form-label">Email</label>
              <input type="email" class="form-control {{#if fieldErrors.email}}is-invalid{{/if}}"
                     id="txtEmail" name="email" required value="{{last.email}}">
              {{#if fieldErrors.email}}
                <div class="invalid-feedback d-block">{{fieldErrors.email}}</div>
              {{/if}}
            </div>


            <div class="mb-3">
              <label for="txtdob" class="form-label">Ngày tháng năm sinh</label>
              <input type="date" class="form-control {{#if fieldErrors.dob}}is-invalid{{/if}}"
                       id="txtdob" name="dob" required value="{{last.dob}}">
              {{#if fieldErrors.dob}}
                <div class="invalid-feedback d-block">{{fieldErrors.dob}}</div>
              {{/if}}
            </div>
            <div class="mb-3">
              <label for="imageUrlInput" class="form-label">Liên kết ảnh đại diện</label>
              <input type="url" id="imageUrlInput" name="image_url" class="form-control"
                     placeholder="https://example.com/profile-image.jpg">
              <div class="form-text">Nhập một đường dẫn ảnh hợp lệ. Phần xem trước sẽ được cập nhật bên dưới.</div>
              <div class="mt-3 text-center">
                  <img id="imagePreview" src="https://via.placeholder.com/150?text=Preview" alt="Profile Image Preview"
                       class="rounded-circle shadow-sm border"
                       style="width: 150px; height: 150px; object-fit: cover; background-color: #f8f9fa;"
                       onerror="handleImageError(this)">
                  <p id="imageError" class="mt-2 small text-danger fw-medium" style="display: none;">
                      <i class="fas fa-exclamation-triangle me-1"></i> Không thể tải phần xem trước.
                  </p>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Giới thiệu bản thân</label>
              <div id="editor_intro" style="height: 200px;"></div>
              <input type="hidden" id="self_introduction_hidden" name="self_introduction">
              <div class="form-text">Thông tin cá nhân của bạn. Chúng tôi sẽ công khai lên hồ sơ của bạn.</div>
            </div>

            <button type="submit" class="btn btn-primary">
              <i class="bi bi-patch-check"></i> Đăng ký
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>

{{!-- This is the only JS block now --}}
{{#fill_section 'js'}}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  async function handleSubmit(event) {
    event.preventDefault();
    if (window.quillInstance) {
      const hiddenInput = document.getElementById('self_introduction_hidden');
      const htmlContent = window.quillInstance.root.innerHTML;
      if (htmlContent === '<p><br></p>') {
        hiddenInput.value = '';
      } else {
        hiddenInput.value = htmlContent;
      }
    }

    const username = document.getElementById('txtUsername').value.trim();
    const password = document.getElementById('txtPassword').value;
    const confirm = document.getElementById('txtConfirm').value;
    if (username.length === 0) {
      alert('Please enter a username');
      return;
    }
    if (username.length < 3) {
      alert('Username must be at least 3 characters long');
      return;
    }
    if (password.length < 6) {
      alert('Password must be at least 6 characters long');
      return;
    }
    if (password !== confirm) {
      alert('Passwords do not match');
      return;
    }

    try {
      const res = await fetch(`/account/is-available?username=${encodeURIComponent(username)}`);
      const isAvailable = await res.json();
      
      if (!isAvailable) {
        alert('Username is not available. Please choose another one');
        return;
      }
      
      event.target.submit();
    } catch (err) {
      console.error(err);
      alert('An error occurred. Please try again');
    }
  }

  function handleImageError(img) {
    img.src = 'https://via.placeholder.com/150?text=Preview';
    const imageError = document.getElementById('imageError');
    if (imageError) imageError.style.display = 'block';
  }
  window.handleImageError = handleImageError; 

  async function signupWithGoogle() {
    try {
      if (!window.supabase) {
        alert('Supabase client not found. Make sure it is loaded in your layout.');
        return;
      }
      const { data, error } = await window.supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: window.location.origin + '/account/oauth-done'
        }
      });
      if (error) {
        console.error(error);
        alert('Google sign-in failed. Please try again.');
      }
    } catch (e) {
      console.error(e);
      alert('Unexpected error during Google sign-in.');
    }
  }
  // Make signupWithGoogle global for onclick
  window.signupWithGoogle = signupWithGoogle; 

  document.addEventListener('DOMContentLoaded', function() {
    
    const frm = document.getElementById('frmRegister');
    if (frm) {
      frm.addEventListener('submit', handleSubmit);
    }
    const imageUrlInput = document.getElementById('imageUrlInput');
    const imagePreview = document.getElementById('imagePreview');
    if (imageUrlInput && imagePreview) {
      imageUrlInput.addEventListener('input', function() {
        const url = this.value;
        const imageError = document.getElementById('imageError');
        if (url) {
          imagePreview.src = url;
          if (imageError) imageError.style.display = 'none';
        } else {
          imagePreview.src = 'https://via.placeholder.com/150?text=Preview';
          if (imageError) imageError.style.display = 'none';
        }
      });
    }
    const editorDiv = document.getElementById('editor_intro');
    if (editorDiv) {
      const toolbarOptions = [
        ['bold', 'italic', 'underline'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        ['clean']
      ];
      window.quillInstance = new Quill('#editor_intro', {
        modules: {
          toolbar: toolbarOptions
        },
        theme: 'snow',
        placeholder: 'Tell us a bit about yourself...'
      });
    }
  });
</script>
{{/fill_section}}