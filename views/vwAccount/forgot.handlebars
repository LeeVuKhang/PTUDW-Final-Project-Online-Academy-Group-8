<div class="container my-4">
  <h3 class="mb-3">Forgot password</h3>
  <p>Enter your account email. We’ll send you a 6-digit code.</p>
  {{#if err}}<div class="alert alert-danger py-2">{{err}}</div>{{/if}}
  {{#if ok}}<div class="alert alert-success py-2">{{ok}}</div>{{/if}}

  <form method="post" action="/account/forgot" class="row g-3">
    <div class="col-12">
      <label class="form-label">Email</label>
      <input class="form-control" type="email" name="email" required>
    </div>
    <div class="col-12">
      <button class="btn btn-primary">Send code</button>
      <a class="btn btn-link" href="/account/signin">Back to sign in</a>
    </div>
  </form>
</div>
