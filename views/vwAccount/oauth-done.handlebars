<h4>Signing you in...</h4>
<script>
  (async () => {
    try {
      const { data: { user }, error } = await window.supabase.auth.getUser();
      if (error || !user) {
        window.location = '/account/signin';
        return;
      }

      const email = user.email;
      const name =
        user?.user_metadata?.full_name ||
        user?.identities?.[0]?.identity_data?.name || '';
      const res = await fetch('/account/sync', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, name, supabase_uid: user.id })
      });

      let out = {};
      try { out = await res.json(); } catch (e) { }

      if (out && out.ok) {
        window.location = out.redirect || '/';
      } else if (out && out.needSignup && out.redirect) {
        window.location = out.redirect;
      } else {
        window.location = '/account/complete';
      }
    } catch (e) {
      console.error('oauth-done error:', e);
      window.location = '/account/signin';
    }
  })();
</script>
