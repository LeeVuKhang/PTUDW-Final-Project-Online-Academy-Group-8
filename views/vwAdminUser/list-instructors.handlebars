{{! 4.3 Quản lý giảng viên - Xem danh sách }}
<div class="container-fluid mt-4">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h4 class="mb-0">
        <i class="bi bi-mortarboard"></i> Quản lý giảng viên
      </h4>
      <div>
        <span class="badge bg-success">{{instructors.length}} giảng viên</span>
        <a href="/admin/users/add-instructor" class="btn btn-primary ms-2">
          <i class="bi bi-plus-lg"></i> Thêm giảng viên
        </a>
      </div>
    </div>
    
    <div class="card-body">
      <!-- Search and Filter -->
      <div class="row mb-3">
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control" id="searchInstructor" placeholder="Tìm kiếm theo tên, email hoặc chuyên môn...">
          </div>
        </div>
        <div class="col-md-4">
          <select class="form-select" id="filterStatus">
            <option value="">Tất cả trạng thái</option>
            <option value="active">Hoạt động</option>
            <option value="inactive">Tạm khóa</option>
          </select>
        </div>
      </div>

      <!-- Instructors Table -->
      {{#if instructors}}
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th scope="col">Avatar</th>
              <th scope="col">Thông tin</th>
              <th scope="col">Email</th>
              <th scope="col">Chuyên môn</th>
              <th scope="col">Khóa học</th>
              <th scope="col">Đánh giá</th>
              <th scope="col">Trạng thái</th>
              <th scope="col" class="text-center">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            {{#each instructors}}
            <tr>
              <td>
                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" 
                     style="width: 40px; height: 40px;">
                  <span class="text-white fw-bold">{{substr name 0 1}}</span>
                </div>
              </td>
              <td>
                <div>
                  <strong>{{name}}</strong>
                  <br>
                  <small class="text-muted">@{{username}}</small>
                  {{#if experience_years}}
                  <br>
                  <small class="text-info">{{experience_years}} năm kinh nghiệm</small>
                  {{/if}}
                </div>
              </td>
              <td>
                <a href="mailto:{{email}}" class="text-decoration-none">{{email}}</a>
              </td>
              <td>
                {{#if specialization}}
                  <span class="badge bg-info">{{specialization}}</span>
                {{else}}
                  <small class="text-muted">Chưa cập nhật</small>
                {{/if}}
              </td>
              <td>
                <div>
                  <span class="badge bg-primary">{{courses_count}} khóa học</span>
                  {{#if total_students}}
                  <br>
                  <small class="text-muted">{{total_students}} học viên</small>
                  {{/if}}
                </div>
              </td>
              <td>
                {{#if average_rating}}
                  <div>
                    <span class="text-warning">★</span> {{average_rating}}/5
                    <br>
                    <small class="text-muted">({{total_reviews}} đánh giá)</small>
                  </div>
                {{else}}
                  <small class="text-muted">Chưa có đánh giá</small>
                {{/if}}
              </td>
              <td>
                {{#if is_active}}
                  <span class="badge bg-success">Hoạt động</span>
                {{else}}
                  <span class="badge bg-warning">Tạm khóa</span>
                {{/if}}
              </td>
              <td class="text-center">
                <div class="btn-group" role="group">
                  <a href="/admin/users/{{user_id}}" 
                     class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                    <i class="bi bi-eye"></i>
                  </a>
                  
                  <a href="/instructor/courses?instructor_id={{user_id}}" 
                     class="btn btn-sm btn-outline-info" title="Xem khóa học">
                    <i class="bi bi-book"></i>
                  </a>
                  
                  {{#if is_active}}
                    <button type="button" 
                            class="btn btn-sm btn-outline-warning" 
                            onclick="toggleUserStatus({{id}}, false)" 
                            title="Tạm khóa tài khoản">
                      <i class="bi bi-lock"></i>
                    </button>
                  {{else}}
                    <button type="button" 
                            class="btn btn-sm btn-outline-success" 
                            onclick="toggleUserStatus({{id}}, true)" 
                            title="Kích hoạt tài khoản">
                      <i class="bi bi-unlock"></i>
                    </button>
                  {{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-5">
        <i class="bi bi-mortarboard display-1 text-muted"></i>
        <h5 class="text-muted mt-3">Chưa có giảng viên nào</h5>
        <a href="/admin/users/add-instructor" class="btn btn-primary mt-3">
          <i class="bi bi-plus-lg"></i> Thêm giảng viên đầu tiên
        </a>
      </div>
      {{/if}}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Search functionality
  const searchInput = document.getElementById('searchInstructor');
  const filterStatus = document.getElementById('filterStatus');
  const tableRows = document.querySelectorAll('tbody tr');

  function filterTable() {
    const searchTerm = searchInput.value.toLowerCase();
    const selectedStatus = filterStatus.value;

    tableRows.forEach(row => {
      const instructorInfo = row.querySelector('td:nth-child(3)').textContent.toLowerCase();
      const email = row.querySelector('td:nth-child(4)').textContent.toLowerCase();
      const specialization = row.querySelector('td:nth-child(5)').textContent.toLowerCase();
      const statusBadge = row.querySelector('td:nth-child(8) .badge');
      const isActive = statusBadge.classList.contains('bg-success');
      
      const statusMatch = !selectedStatus || 
                         (selectedStatus === 'active' && isActive) || 
                         (selectedStatus === 'inactive' && !isActive);
      const searchMatch = instructorInfo.includes(searchTerm) || 
                         email.includes(searchTerm) || 
                         specialization.includes(searchTerm);

      row.style.display = (statusMatch && searchMatch) ? '' : 'none';
    });
  }

  searchInput.addEventListener('input', filterTable);
  filterStatus.addEventListener('change', filterTable);
});

function toggleUserStatus(userId, activate) {
  const action = activate ? 'activate' : 'deactivate';
  const actionText = activate ? 'kích hoạt' : 'tạm khóa';
  
  if (confirm(`Bạn có chắc muốn ${actionText} tài khoản giảng viên này?`)) {
    fetch(`/admin/users/${userId}/${action}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Có lỗi xảy ra: ' + data.message);
      }
    })
    .catch(error => {
      alert('Có lỗi xảy ra: ' + error.message);
    });
  }
}
</script>
