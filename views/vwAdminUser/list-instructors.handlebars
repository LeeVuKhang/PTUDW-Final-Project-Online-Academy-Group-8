{{! 4.3 Quản lý giảng viên - Xem danh sách }}
<div class="container-fluid mt-4">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h4 class="mb-0">
        <i class="bi bi-mortarboard"></i> Quản lý giảng viên
      </h4>
      <div>
        <span class="badge bg-success">{{totalItems}} giảng viên</span>
        <a href="/admin/users/add-instructor" class="btn btn-primary ms-2">
          <i class="bi bi-person-plus"></i> Thêm giảng viên
        </a>
      </div>
    </div>
    
    <div class="card-body">
      <!-- Search & Filters -->
      <form method="GET" action="/admin/users/instructors" class="mb-4">
        <div class="row g-3">
          <div class="col-md-12">
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-search"></i>
              </span>
              <input type="text" class="form-control" name="search" placeholder="Tìm kiếm theo tên, email hoặc username..." value="{{filters.searchTerm}}">
              <button type="submit" class="btn btn-primary">Tìm kiếm</button>
              {{#if filters.searchTerm}}
              <a href="/admin/users/instructors" class="btn btn-secondary">Xóa bộ lọc</a>
              {{/if}}
            </div>
          </div>
        </div>
      </form>

      <!-- Instructors Table -->
      {{#if instructors}}
      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead class="table-dark">
            <tr>
              <th scope="col">Avatar</th>
              <th scope="col">Thông tin</th>
              <th scope="col">Email</th>
              <th scope="col">Khóa học</th>
              <th scope="col">Đánh giá</th>
              <th scope="col" class="text-center">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            {{#each instructors}}
            <tr>
              <td>
                {{#if image_url}}
                  <img src="{{image_url}}" alt="Avatar" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                {{else}}
                  <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" 
                       style="width: 40px; height: 40px;">
                    <span class="text-white fw-bold">{{substr name 0 1}}</span>
                  </div>
                {{/if}}
              </td>
              <td>
                <div>
                  <strong>{{name}}</strong>
                  <br>
                  <small class="text-muted">@{{username}}</small>
                  {{#if experience_years}}
                  <br>
                  <small class="text-info">{{experience_years}} năm kinh nghiệm</small>
                  {{/if}}
                </div>
              </td>
              <td>
                <a href="mailto:{{email}}" class="text-decoration-none">{{email}}</a>
              </td>
              <td>
                <div>
                  <span class="badge bg-primary">{{courses_count}} khóa học</span>
                  {{#if total_students}}
                  <br>
                  <small class="text-muted">{{total_students}} học viên</small>
                  {{/if}}
                </div>
              </td>
              <td>
                {{#if average_rating}}
                  <div>
                    <span class="text-warning">★</span> {{average_rating}}/5
                    <br>
                    <small class="text-muted">({{total_reviews}} đánh giá)</small>
                  </div>
                {{else}}
                  <small class="text-muted">Chưa có đánh giá</small>
                {{/if}}
              </td>
              <td class="text-center">
                <div class="btn-group" role="group">
                  <a href="/admin/users/{{user_id}}" 
                     class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                    <i class="bi bi-eye"></i>
                  </a>
                  <button type="button"
        class="btn btn-sm {{#if is_locked}}btn-success{{else}}btn-outline-warning{{/if}}"
        title="{{#if is_locked}}Mở khóa tài khoản{{else}}Tạm khóa tài khoản{{/if}}"
        onclick="toggleUserStatus({{user_id}}, {{#if is_locked}}true{{else}}false{{/if}})">
  <i class="bi {{#if is_locked}}bi-unlock{{else}}bi-lock{{/if}}"></i>
</button>

                  
                  <form method="POST" action="/admin/users/{{user_id}}/delete" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa giảng viên" onclick="return confirm('Bạn có chắc chắn muốn xóa giảng viên {{name}}?')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-5">
        <i class="bi bi-mortarboard display-1 text-muted"></i>
        <h5 class="text-muted mt-3">Chưa có giảng viên nào</h5>
        <a href="/admin/users/add-instructor" class="btn btn-primary mt-3">
          <i class="bi bi-plus-lg"></i> Thêm giảng viên đầu tiên
        </a>
      </div>
      {{/if}}

      <!-- Pagination -->
      {{#if (isGreater pagination.totalPages 1)}}
      <div class="d-flex justify-content-between align-items-center mt-4">
          <span class="text-muted">
              Hiển thị {{currentItemsCount}} trên tổng số {{totalItems}} {{itemType}}
          </span>
          
          <nav aria-label="{{itemType}} pagination">
              <ul class="pagination justify-content-end mb-0">
                  <li class="page-item {{#unless pagination.hasPrevPage}}disabled{{/unless}}">
                      <a class="page-link" href="{{createPaginationLink pagination.prevPage queryParams}}"
                          tabindex="-1" aria-disabled="true">Trước</a>
                  </li>
                  {{#each pagination.pageNumbers}}
                  <li class="page-item {{#if this.isCurrent}}active{{/if}}">
                      <a class="page-link"
                          href="{{createPaginationLink this.value ../../queryParams}}">{{this.value}}</a>
                  </li>
                  {{/each}}
                  <li class="page-item {{#unless pagination.hasNextPage}}disabled{{/unless}}">
                      <a class="page-link"
                          href="{{createPaginationLink pagination.nextPage queryParams}}">Sau</a>
                  </li>
              </ul>
          </nav>
      </div>
      {{/if}}
      

    </div>
  </div>
</div>

<script>
function toggleUserStatus(userId, activate) {
  const action = activate ? 'activate' : 'deactivate';
  const actionText = activate ? 'kích hoạt' : 'tạm khóa';
  
  if (confirm(`Bạn có chắc muốn ${actionText} tài khoản này?`)) {
    fetch(`/admin/users/${userId}/${action}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Có lỗi xảy ra: ' + data.message);
      }
    })
    .catch(error => {
      alert('Có lỗi xảy ra: ' + error.message);
    });
  }
}
</script>
